  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Workloads.10.0.100" Version="10.110.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SelfCheckoutKiosk.Core\SelfCheckoutKiosk.Core.csproj" />
  </ItemGroup>
