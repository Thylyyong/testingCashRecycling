<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================= -->
    <!-- GLOBAL FONTS -->
    <!-- ========================================================= -->
    <FontFamily x:Key="AppPrimaryFont">Segoe UI</FontFamily>
    <FontFamily x:Key="AppKhmerFont">ms-appx:///Assets/Fonts/NotoSansKhmer.ttf#Noto Sans Khmer</FontFamily>

    <FontFamily x:Key="GlobalAppFont">Segoe UI, ms-appx:///Assets/Fonts/NotoSansKhmer.ttf#Noto Sans Khmer</FontFamily>
    <FontFamily x:Key="ContentControlThemeFontFamily">{StaticResource GlobalAppFont}</FontFamily>

    <!-- Implicit Style for Dialog -->
    <Style TargetType="ContentDialog">
        <Setter Property="FontFamily" Value="{StaticResource GlobalAppFont}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="RequestedTheme" Value="Light"/>
    </Style>

    <!-- Implicit Style for TextBlock -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource GlobalAppFont}" />
    </Style>

    <!-- Implicit Style for TextBox / PasswordBox / AutoSuggestBox -->
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource GlobalAppFont}" />
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="#1A202C"/>
        <Setter Property="BorderBrush" Value="#CBD5E1"/>
    </Style>

    <!-- Implicit Style for Button -->
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource GlobalAppFont}" />
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="AllowFocusOnInteraction" Value="False"/>
    </Style>

    <Style x:Key="DialogButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource GlobalAppFont}"/>
        <Setter Property="Background" Value="#F1F5F9"/>
        <Setter Property="Foreground" Value="#0F172A"/>
        <Setter Property="BorderBrush" Value="#CBD5E1"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter
                        x:Name="ContentPresenter"
                        Background="{TemplateBinding Background}"
                        Foreground="{TemplateBinding Foreground}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Background" Value="#E2E8F0"/>
                                        <Setter Target="ContentPresenter.Foreground" Value="#0F172A"/>
                                        <Setter Target="ContentPresenter.BorderBrush" Value="#94A3B8"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Background" Value="#CBD5E1"/>
                                        <Setter Target="ContentPresenter.Foreground" Value="#0F172A"/>
                                        <Setter Target="ContentPresenter.BorderBrush" Value="#64748B"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Background" Value="#F8FAFC"/>
                                        <Setter Target="ContentPresenter.Foreground" Value="#94A3B8"/>
                                        <Setter Target="ContentPresenter.BorderBrush" Value="#E2E8F0"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ContentPresenter>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AccentButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource GlobalAppFont}"/>
        <Setter Property="Background" Value="#2563EB"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter
                        x:Name="ContentPresenter"
                        Background="{TemplateBinding Background}"
                        Foreground="{TemplateBinding Foreground}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Background" Value="#1D4ED8"/>
                                        <Setter Target="ContentPresenter.Foreground" Value="White"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Background" Value="#1E40AF"/>
                                        <Setter Target="ContentPresenter.Foreground" Value="White"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Background" Value="#E2E8F0"/>
                                        <Setter Target="ContentPresenter.Foreground" Value="#94A3B8"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ContentPresenter>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Keypad Styles with guaranteed dark contrast on hover -->
    <Style x:Key="KeypadDigitButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource GlobalAppFont}"/>
        <Setter Property="Background" Value="#F1F5F9"/>
        <Setter Property="Foreground" Value="#0F172A"/>
        <Setter Property="BorderBrush" Value="#CBD5E1"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter
                        x:Name="ContentPresenter"
                        Background="{TemplateBinding Background}"
                        Foreground="{TemplateBinding Foreground}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Background" Value="#E2E8F0"/>
                                        <Setter Target="ContentPresenter.Foreground" Value="#0F172A"/>
                                        <Setter Target="ContentPresenter.BorderBrush" Value="#94A3B8"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Background" Value="#CBD5E1"/>
                                        <Setter Target="ContentPresenter.Foreground" Value="#0F172A"/>
                                        <Setter Target="ContentPresenter.BorderBrush" Value="#64748B"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ContentPresenter>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="KeypadDangerButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource GlobalAppFont}"/>
        <Setter Property="Background" Value="#FEE2E2"/>
        <Setter Property="Foreground" Value="#DC2626"/>
        <Setter Property="BorderBrush" Value="#FECACA"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter
                        x:Name="ContentPresenter"
                        Background="{TemplateBinding Background}"
                        Foreground="{TemplateBinding Foreground}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Background" Value="#FCA5A5"/>
                                        <Setter Target="ContentPresenter.Foreground" Value="#991B1B"/>
                                        <Setter Target="ContentPresenter.BorderBrush" Value="#F87171"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Background" Value="#EF4444"/>
                                        <Setter Target="ContentPresenter.Foreground" Value="White"/>
                                        <Setter Target="ContentPresenter.BorderBrush" Value="#DC2626"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ContentPresenter>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="KioskContentDialogStyle" TargetType="ContentDialog">
        <Setter Property="FontFamily" Value="{StaticResource GlobalAppFont}"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#E2E8F0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RequestedTheme" Value="Light"/>
    </Style>

    <!-- Theme Overrides for TextBoxes & Controls in Light Mode -->
    <SolidColorBrush x:Key="TextControlBackground" Color="White"/>
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="White"/>
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="White"/>
    <SolidColorBrush x:Key="TextControlForeground" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#94A3B8"/>
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#2563EB"/>
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#94A3B8"/>
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#94A3B8"/>
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#94A3B8"/>

    <!-- Theme Overrides for ToggleSwitch in Light Mode -->
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#2563EB"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#1E40AF"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="#94A3B8"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#94A3B8"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#64748B"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="#475569"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#2563EB"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#1E40AF"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="White"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="White"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="White"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#64748B"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#475569"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="#334155"/>

    <!-- Custom Admin Input Field Style -->
    <Style x:Key="AdminTextBoxStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource GlobalAppFont}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="#0F172A"/>
        <Setter Property="BorderBrush" Value="#CBD5E1"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="SelectionHighlightColor" Value="#2563EB"/>
    </Style>

    <!-- Custom Admin Toggle Switch Style -->
    <Style x:Key="AdminToggleSwitchStyle" TargetType="ToggleSwitch">
        <Setter Property="FontFamily" Value="{StaticResource GlobalAppFont}"/>
        <Setter Property="Foreground" Value="#0F172A"/>
    </Style>
    
    <!-- Font Sizes -->
    <x:Double x:Key="FontSizeCaption">10</x:Double>
    <x:Double x:Key="FontSizeSubLabel">11</x:Double>
    <x:Double x:Key="FontSizeBody">12</x:Double>
    <x:Double x:Key="FontSizeBodyLarge">13</x:Double>
    <x:Double x:Key="FontSizeSubtitle">14</x:Double>
    <x:Double x:Key="FontSizeTitleSmall">16</x:Double>
    <x:Double x:Key="FontSizeTitle">18</x:Double>
    <x:Double x:Key="FontSizeHeroSmall">22</x:Double>
    <x:Double x:Key="FontSizeHeroMedium">26</x:Double>
    <x:Double x:Key="FontSizeHeroLarge">32</x:Double>

    <!-- ========================================================= -->
    <!-- BRAND COLOR PALETTE -->
    <!-- ========================================================= -->
    <!-- Primaries -->
    <SolidColorBrush x:Key="PrimaryBrandBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="PrimaryBrandHoverBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="PrimaryBrandPressedBrush" Color="#1E40AF"/>
    <SolidColorBrush x:Key="PrimaryBrandLightBrush" Color="#EFF6FF"/>
    <SolidColorBrush x:Key="PrimaryBrandBorderBrush" Color="#BFDBFE"/>

    <!-- Accent / Secondary -->
    <SolidColorBrush x:Key="AccentBlueBrush" Color="#0067C0"/>
    <SolidColorBrush x:Key="AccentBlueLightBrush" Color="#38A5F0"/>
    <SolidColorBrush x:Key="AccentBlueChipHoverBrush" Color="#2D8EDD"/>
    <SolidColorBrush x:Key="AccentBlueChipPressedBrush" Color="#166BAE"/>
    <SolidColorBrush x:Key="AccentBlueChipDisabledBrush" Color="#005096"/>
    <SolidColorBrush x:Key="AccentBlueSoftBrush" Color="#D6E9FA"/>

    <!-- Text Colors -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A202C"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="TextDarkSlateBrush" Color="#334155"/>
    <SolidColorBrush x:Key="TextItemNameBrush" Color="#2D3748"/>
    <SolidColorBrush x:Key="TextQuantityBrush" Color="#718096"/>
    <SolidColorBrush x:Key="TextSubLabelBrush" Color="#A0AEC0"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="White"/>

    <!-- Backgrounds & Borders -->
    <SolidColorBrush x:Key="SurfaceLightBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#FFF4F6F8"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="White"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="SubtleBackgroundBrush" Color="#EDF2F7"/>
    <SolidColorBrush x:Key="ButtonBackgroundPointerOverBrush" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="ButtonBackgroundPressedBrush" Color="#D1D5DB"/>
    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#94A3B8"/>

    <!-- Success / Highlight -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#059669"/>
    <SolidColorBrush x:Key="SuccessLightBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#ECFDF5"/>
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#A7F3D0"/>
    <SolidColorBrush x:Key="RowHighlightBrush" Color="#3310B981"/>
    <SolidColorBrush x:Key="RowFlashStartBrush" Color="#4010B981"/>
    <SolidColorBrush x:Key="RowDefaultBackgroundBrush" Color="Transparent"/>

    <!-- Danger / Destructive -->
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#B91C1C"/>
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#991B1B"/>
    <SolidColorBrush x:Key="DangerLightBrush" Color="#FEE2E2"/>
    <SolidColorBrush x:Key="DangerLightPressedBrush" Color="#FECACA"/>
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#FECACA"/>

    <!-- Gradients -->
    <LinearGradientBrush x:Key="PrimaryCardGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2563EB" Offset="0"/>
        <GradientStop Color="#1D4ED8" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PrimaryHeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2563EB" Offset="0"/>
        <GradientStop Color="#1D4ED8" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeaderBannerGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0067C0" Offset="0"/>
        <GradientStop Color="#38A5F0" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CheckoutButtonGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2563EB" Offset="0"/>
        <GradientStop Color="#1D4ED8" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SuccessGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#059669" Offset="0"/>
        <GradientStop Color="#10B981" Offset="1"/>
    </LinearGradientBrush>

    <!-- ========================================================= -->
    <!-- KIOSK UI LAYOUT METRICS -->
    <!-- ========================================================= -->
    <CornerRadius x:Key="KioskCardCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="KioskHeroCardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="KioskButtonCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="KioskChipCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="KioskPillCornerRadius">24</CornerRadius>

</ResourceDictionary>