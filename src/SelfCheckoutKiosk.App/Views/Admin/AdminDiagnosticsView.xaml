<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SelfCheckoutKiosk.App.Views.Admin.AdminDiagnosticsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SelfCheckoutKiosk.App.Views.Admin"
    xmlns:models="using:SelfCheckoutKiosk.App.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="DiagnosticsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Page.Resources>

    <Grid Background="#F1F5F9">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <!-- Portrait / Narrow Screens (540px, 1080px, 1440px) -->
                <VisualState x:Name="PortraitState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" MinWindowHeight="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderContainer.Padding" Value="20,16"/>
                        <Setter Target="ContentScrollViewer.Padding" Value="20,16"/>
                        <Setter Target="TwoColumnGrid.Visibility" Value="Collapsed"/>
                        <Setter Target="SingleColumnStack.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>

                <!-- Horizontal Widescreen (16:9: >= 1100px) -->
                <VisualState x:Name="HorizontalState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" MinWindowHeight="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderContainer.Padding" Value="32,18"/>
                        <Setter Target="ContentScrollViewer.Padding" Value="32,18"/>
                        <Setter Target="TwoColumnGrid.Visibility" Value="Visible"/>
                        <Setter Target="SingleColumnStack.Visibility" Value="Collapsed"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR (Identical Padding to Cards) -->
        <Border Grid.Row="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1">
            <Grid x:Name="HeaderContainer" Padding="20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Admin Diagnostics" FontSize="22" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        <Border Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="System Operational" Foreground="#166534" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Attendant Hardware &amp; Vault Diagnostics" Foreground="#64748B" FontSize="12" FontWeight="Medium"/>
                </StackPanel>

                <!-- Clean Close Button in Header -->
                <Button
                    x:Name="CloseButton"
                    Grid.Column="1"
                    Click="CloseButton_Click"
                    Height="38"
                    Padding="16,0"
                    CornerRadius="8"
                    VerticalAlignment="Center"
                    Style="{StaticResource DialogButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE711;" FontSize="12" Foreground="#0F172A"/>
                        <TextBlock Text="Close" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- MAIN SCROLLABLE CONTENT (Aligned Symmetrically with Header) -->
        <ScrollViewer x:Name="ContentScrollViewer" Grid.Row="1" Padding="20,16" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="0" HorizontalAlignment="Stretch">

                <!-- STATUS MESSAGE BANNER (if triggered) -->
                <Border
                    Visibility="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                    Background="{StaticResource SuccessSoftBrush}"
                    BorderBrush="{StaticResource SuccessBorderBrush}"
                    BorderThickness="1.5"
                    CornerRadius="10"
                    Padding="14,10"
                    Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE73E;" FontSize="15" Foreground="{StaticResource SuccessBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- PROMINENT MEDIA & BRANDING ACCESS CARD (Moved out of Header) -->
                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="12" Padding="18,14" Margin="0,0,0,14" HorizontalAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Margin="0,0,12,0">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEB9F;" FontSize="18" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Media &amp; Branding Management" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                            <TextBlock Text="Configure welcome attract playlist and branding configurations" FontSize="12" Foreground="#64748B" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Button
                            x:Name="MediaBrandingButton"
                            Grid.Column="2"
                            Click="MediaBrandingButton_Click"
                            Height="38"
                            Padding="16,0"
                            CornerRadius="8"
                            VerticalAlignment="Center"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Open" FontWeight="Bold" FontSize="13" Foreground="White"/>
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE76C;" FontSize="11" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- ======================================================== -->
                <!-- 1. HORIZONTAL WIDESCREEN 2-COLUMN VIEW -->
                <!-- ======================================================== -->
                <Grid x:Name="TwoColumnGrid" ColumnSpacing="16" Visibility="Visible" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN -->
                    <StackPanel Grid.Column="0" Spacing="0">
                        <!-- Hardware Connectivity Card -->
                        <Border Style="{StaticResource DiagnosticsCardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Hardware Connectivity" Style="{StaticResource SectionHeaderStyle}"/>

                                <ItemsControl ItemsSource="{x:Bind ViewModel.HardwareDevices}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="8"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:HardwareDeviceStatus">
                                            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,10,0">
                                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="{x:Bind Glyph}" FontSize="15" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                        <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                                                        <TextBlock Text="{x:Bind PortOrInterface}" FontSize="12" Foreground="#64748B"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <Ellipse Width="10" Height="10" Fill="{x:Bind StatusColor}"/>
                                                        <TextBlock Text="{x:Bind StatusText}" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Cash Recycler Cassettes Card -->
                        <Border Style="{StaticResource DiagnosticsCardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Cash Recycler Vault Breakdown" Style="{StaticResource SectionHeaderStyle}"/>

                                <TextBlock Text="Khmer Riel (KHR)" FontSize="13" FontWeight="Bold" Foreground="#475569"/>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.KhrCassettes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" ItemWidth="125" ItemHeight="42"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:CassetteCountItem">
                                            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,6,6">
                                                <TextBlock FontSize="12" Foreground="#0F172A" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Run Text="{x:Bind DenominationLabel}" FontWeight="Bold"/>
                                                    <Run Text=" : " Foreground="#94A3B8"/>
                                                    <Run Text="{x:Bind Count, Mode=OneWay}" FontWeight="SemiBold" Foreground="#2563EB"/>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="US Dollar (USD)" FontSize="13" FontWeight="Bold" Foreground="#475569" Margin="0,8,0,0"/>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.UsdCassettes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" ItemWidth="125" ItemHeight="42"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:CassetteCountItem">
                                            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,6,6">
                                                <TextBlock FontSize="12" Foreground="#0F172A" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Run Text="{x:Bind DenominationLabel}" FontWeight="Bold"/>
                                                    <Run Text=" : " Foreground="#94A3B8"/>
                                                    <Run Text="{x:Bind Count, Mode=OneWay}" FontWeight="SemiBold" Foreground="#2563EB"/>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Hardware Logs Card -->
                        <Border Style="{StaticResource DiagnosticsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Unresolved Hardware Logs" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                                    <TextBlock Text="Hardware fault and error queue" FontSize="12" Foreground="#64748B"/>
                                </StackPanel>

                                <Border Grid.Column="1" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="6" Padding="14,4" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.UnresolvedLogCount, Mode=OneWay}" FontWeight="Bold" FontSize="16" Foreground="#166534"/>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- RIGHT COLUMN -->
                    <StackPanel Grid.Column="1" Spacing="0">
                        <!-- License Card -->
                        <Border Style="{StaticResource DiagnosticsCardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="License &amp; Activation" Style="{StaticResource SectionHeaderStyle}"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="Tier:" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                                        <TextBlock Text="{x:Bind ViewModel.LicenseTier, Mode=OneWay}" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="Expires:" FontSize="12" FontWeight="SemiBold" Foreground="#64748B"/>
                                        <TextBlock Text="{x:Bind ViewModel.LicenseExpiry, Mode=OneWay}" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                                    </StackPanel>
                                </Grid>

                                <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,4,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xED14;" FontSize="15" Foreground="#2563EB"/>
                                        <TextBlock Text="Scan a license QR code to activate or renew." FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Cloud Sync Card -->
                        <Border Style="{StaticResource DiagnosticsCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Cloud Synchronization" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                                    <TextBlock FontSize="12" Foreground="#64748B">
                                        <Run Text="Last Sync: "/>
                                        <Run Text="{x:Bind ViewModel.LastSyncTime, Mode=OneWay}" FontWeight="SemiBold" Foreground="#0F172A"/>
                                    </TextBlock>
                                </StackPanel>

                                <Button
                                    Grid.Column="1"
                                    Click="SyncCloudButton_Click"
                                    IsEnabled="{x:Bind ViewModel.IsNotSyncing, Mode=OneWay}"
                                    Height="38"
                                    Padding="16,0"
                                    CornerRadius="8"
                                    Style="{StaticResource DialogButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE895;" FontSize="13" Foreground="#2563EB"/>
                                        <TextBlock Text="Sync Now" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Receipt Printing Card -->
                        <Border Style="{StaticResource DiagnosticsCardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Thermal Receipt" Style="{StaticResource SectionHeaderStyle}"/>
                                <Button
                                    x:Name="ReprintButton"
                                    Click="ReprintReceiptButton_Click"
                                    Height="42"
                                    Padding="20,0"
                                    HorizontalAlignment="Left"
                                    CornerRadius="8"
                                    Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE749;" FontSize="14" Foreground="White"/>
                                        <TextBlock Text="Reprint Last Receipt" FontWeight="Bold" FontSize="13" Foreground="White"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ======================================================== -->
                <!-- 2. VERTICAL PORTRAIT SINGLE-COLUMN VIEW -->
                <!-- ======================================================== -->
                <StackPanel x:Name="SingleColumnStack" Spacing="0" Visibility="Collapsed" HorizontalAlignment="Stretch">
                    <!-- Hardware Connectivity Card -->
                    <Border Style="{StaticResource DiagnosticsCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Hardware Connectivity" Style="{StaticResource SectionHeaderStyle}"/>

                            <ItemsControl ItemsSource="{x:Bind ViewModel.HardwareDevices}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="8"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:HardwareDeviceStatus">
                                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,10,0">
                                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="{x:Bind Glyph}" FontSize="15" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                                    <TextBlock Text="{x:Bind PortOrInterface}" FontSize="11" Foreground="#64748B"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Ellipse Width="8" Height="8" Fill="{x:Bind StatusColor}"/>
                                                    <TextBlock Text="{x:Bind StatusText}" FontWeight="Bold" FontSize="12" Foreground="#0F172A"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Cash Recycler Cassettes Card (3 Columns with responsive ItemWidth) -->
                    <Border Style="{StaticResource DiagnosticsCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Cash Recycler Vault Breakdown" Style="{StaticResource SectionHeaderStyle}"/>

                            <TextBlock Text="Khmer Riel (KHR)" FontSize="12" FontWeight="Bold" Foreground="#475569"/>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.KhrCassettes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" ItemWidth="115" ItemHeight="38"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:CassetteCountItem">
                                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="4,2" Margin="0,0,4,4">
                                            <TextBlock FontSize="11" Foreground="#0F172A" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Run Text="{x:Bind DenominationLabel}" FontWeight="Bold"/>
                                                <Run Text=" : " Foreground="#94A3B8"/>
                                                <Run Text="{x:Bind Count, Mode=OneWay}" FontWeight="SemiBold" Foreground="#2563EB"/>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="US Dollar (USD)" FontSize="12" FontWeight="Bold" Foreground="#475569" Margin="0,6,0,0"/>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.UsdCassettes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" ItemWidth="115" ItemHeight="38"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:CassetteCountItem">
                                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="4,2" Margin="0,0,4,4">
                                            <TextBlock FontSize="11" Foreground="#0F172A" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Run Text="{x:Bind DenominationLabel}" FontWeight="Bold"/>
                                                <Run Text=" : " Foreground="#94A3B8"/>
                                                <Run Text="{x:Bind Count, Mode=OneWay}" FontWeight="SemiBold" Foreground="#2563EB"/>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Hardware Logs Card -->
                    <Border Style="{StaticResource DiagnosticsCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Unresolved Hardware Logs" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                <TextBlock Text="Hardware fault and error queue" FontSize="11" Foreground="#64748B"/>
                            </StackPanel>

                            <Border Grid.Column="1" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="6" Padding="12,3" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.UnresolvedLogCount, Mode=OneWay}" FontWeight="Bold" FontSize="15" Foreground="#166534"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- License Card -->
                    <Border Style="{StaticResource DiagnosticsCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="License &amp; Activation" Style="{StaticResource SectionHeaderStyle}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Tier:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                                    <TextBlock Text="{x:Bind ViewModel.LicenseTier, Mode=OneWay}" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Expires:" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                                    <TextBlock Text="{x:Bind ViewModel.LicenseExpiry, Mode=OneWay}" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                </StackPanel>
                            </Grid>

                            <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,4,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xED14;" FontSize="14" Foreground="#2563EB"/>
                                    <TextBlock Text="Scan a license QR code to activate or renew." FontSize="11" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Cloud Sync Card -->
                    <Border Style="{StaticResource DiagnosticsCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Cloud Synchronization" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                <TextBlock FontSize="11" Foreground="#64748B">
                                    <Run Text="Last Sync: "/>
                                    <Run Text="{x:Bind ViewModel.LastSyncTime, Mode=OneWay}" FontWeight="SemiBold" Foreground="#0F172A"/>
                                </TextBlock>
                            </StackPanel>

                            <Button
                                Grid.Column="1"
                                Click="SyncCloudButton_Click"
                                IsEnabled="{x:Bind ViewModel.IsNotSyncing, Mode=OneWay}"
                                Height="36"
                                Padding="14,0"
                                CornerRadius="6"
                                Style="{StaticResource DialogButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE895;" FontSize="12" Foreground="#2563EB"/>
                                    <TextBlock Text="Sync Now" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Receipt Printing Card -->
                    <Border Style="{StaticResource DiagnosticsCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Thermal Receipt" Style="{StaticResource SectionHeaderStyle}"/>
                            <Button
                                Click="ReprintReceiptButton_Click"
                                Height="40"
                                Padding="18,0"
                                HorizontalAlignment="Left"
                                CornerRadius="8"
                                Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE749;" FontSize="13" Foreground="White"/>
