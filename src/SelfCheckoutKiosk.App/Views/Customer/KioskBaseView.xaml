<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SelfCheckoutKiosk.App.Views.Customer.KioskBaseView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SelfCheckoutKiosk.App.Views.Customer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SelfCheckoutKiosk.App.Models"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <Grid Background="Black">

        <!-- ========================================================= -->
        <!-- ADAPTIVE VISUAL STATES                                    -->
        <!-- ========================================================= -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="AdaptiveLayoutStates">

                <!-- 1. Horizontal Kiosk: 16:9, 17.3 Inches (1920x1080) -->
                <VisualState x:Name="Horizontal17InchState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowHeight="0" MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ScrimRectangle.Height" Value="280" />
                        <Setter Target="BrandingStackPanel.Margin" Value="40,0,0,40" />
                        <Setter Target="WelcomeTextBlock.FontSize" Value="16" />
                        <Setter Target="TitleTextBlock.FontSize" Value="42" />
                        <Setter Target="TapPromptTextBlock.FontSize" Value="18" />
                        <Setter Target="IndicatorDots.Margin" Value="0,0,40,48" />
                    </VisualState.Setters>
                </VisualState>

                <!-- 2. Vertical Kiosk: 9:16, 27.5 Inches (1080x1920) -->
                <VisualState x:Name="Vertical27InchState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowHeight="1200" MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ScrimRectangle.Height" Value="420" />
                        <Setter Target="BrandingStackPanel.Margin" Value="56,0,0,64" />
                        <Setter Target="WelcomeTextBlock.FontSize" Value="24" />
                        <Setter Target="TitleTextBlock.FontSize" Value="68" />
                        <Setter Target="TapPromptTextBlock.FontSize" Value="26" />
                        <Setter Target="IndicatorDots.Margin" Value="0,0,56,72" />
                    </VisualState.Setters>
                </VisualState>

            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- ========================================================= -->
        <!-- FULL SCREEN INTERACTIVE BANNER CONTAINER                  -->
        <!-- ========================================================= -->
        <Grid x:Name="BannerContainer"
              Background="#111827"
              ManipulationMode="TranslateX"
              PointerPressed="BannerContainer_PointerPressed"
              ManipulationStarted="BannerContainer_ManipulationStarted"
              ManipulationCompleted="BannerContainer_ManipulationCompleted"
              PointerWheelChanged="BannerContainer_PointerWheelChanged"
              Tapped="BannerContainer_Tapped">

            <!-- Banner Images with Crossfade -->
            <Image x:Name="BannerImageA" Stretch="UniformToFill" Opacity="1"/>
            <Image x:Name="BannerImageB" Stretch="UniformToFill" Opacity="0"/>

            <!-- Gradient Scrim for Contrast -->
            <Rectangle x:Name="ScrimRectangle" VerticalAlignment="Bottom" Height="320" IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="#D9000000" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Store Branding & Tap Prompt Overlay -->
            <StackPanel x:Name="BrandingStackPanel" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="40,0,0,40" Spacing="8" IsHitTestVisible="False">
                <TextBlock x:Name="WelcomeTextBlock" Text="WELCOME TO" FontSize="16" FontWeight="SemiBold" Foreground="#E2E8F0" CharacterSpacing="80"/>
                <TextBlock x:Name="TitleTextBlock" Text="Self-Checkout" FontSize="42" FontWeight="Bold" Foreground="White"/>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                    <TextBlock x:Name="TapPromptTextBlock" Text="Tap anywhere to start" FontSize="18" FontWeight="SemiBold" Foreground="#60A5FA"/>
                    <!--<FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE76C;" FontSize="16" Foreground="#60A5FA" VerticalAlignment="Center"/>-->
                </StackPanel>
            </StackPanel>

            <!-- Page Indicator Dots -->
            <ItemsControl x:Name="IndicatorDots" ItemsSource="{x:Bind ViewModel.BannerMediaPaths, Mode=OneWay}" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,40,48" IsHitTestVisible="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Rectangle Width="7" Height="7" Fill="White" Opacity="0.35"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</Page>