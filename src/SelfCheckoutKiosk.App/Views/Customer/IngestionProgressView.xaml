<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SelfCheckoutKiosk.App.Views.Customer.IngestionProgressView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SelfCheckoutKiosk.App.Views.Customer"
    xmlns:models="using:SelfCheckoutKiosk.App.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Light">

    <Page.Resources>

        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#EFF6FF"/>
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#DBEAFE"/>

        <Style x:Key="HeaderChipButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1F7FCB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Height" Value="40"/>
        </Style>

        <!-- Kiosk-sized touch target note button style -->
        <Style x:Key="NoteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>

    </Page.Resources>

    <Grid Background="#FFF4F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. HEADER -->
        <Border Grid.Row="0" Background="#0067C0" Padding="20,16" Height="80">
            <Grid VerticalAlignment="Center">

                <!-- 1. Centered Title (Stays dead-center of the entire header) -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                    <!--<FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8C7;" FontSize="24" Foreground="White"/>-->
                    <TextBlock Text="Cash Payment" Foreground="White" FontSize="26" FontWeight="Bold"/>
                </StackPanel>

                <!-- 2. Left Floating Button (With Hover, Pressed, and Disabled states) -->
                <Button x:Name="BackButton" 
                    Width="60" 
                    Height="50" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Center" 
                    CornerRadius="10"
                    Style="{StaticResource HeaderChipButtonStyle}">

                    <Button.Resources>
                        <!-- Pointer Over & Pressed States -->
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2D8EDD"/>
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#166BAE"/>

                        <!-- Disabled States -->
                        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#005096"/>
                        <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#66FFFFFF"/>
                        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent"/>

                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/>
                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White"/>
                    </Button.Resources>

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE830;" FontSize="20"/>
                    </StackPanel>
                </Button>

            </Grid>
        </Border>

        <!-- 2. BODY (Fixed content on top, scrollable activity region taking remaining vertical space) -->
        <Grid Grid.Row="1" RowSpacing="16" Margin="24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Balance Section -->
                <RowDefinition Height="Auto"/>
                <!-- Cash Insertion Buttons -->
                <RowDefinition Height="*"/>
                <!-- Activity Feed (Scrollable) -->
            </Grid.RowDefinitions>

            <!-- BALANCE SUMMARY -->
            <StackPanel Grid.Row="0" Spacing="10">

                <!-- Hero: remaining balance -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="16,12">
                    <StackPanel Spacing="6">
                        <TextBlock Text="AMOUNT REMAINING" FontSize="12" FontWeight="SemiBold" Foreground="#A0AEC0" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="RemainingDueText" FontSize="32" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Center"/>
                        <ProgressBar x:Name="PaidProgressBar" Minimum="0" Maximum="100" Value="0" Height="8" CornerRadius="4"
                                     Foreground="#059669" Background="#E2E8F0"/>
                    </StackPanel>
                </Border>

                <!-- Sub stats -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="12,10">
                        <StackPanel Spacing="2">
                            <TextBlock Text="TOTAL DUE" FontSize="11" FontWeight="SemiBold" Foreground="#A0AEC0"/>
                            <TextBlock x:Name="TotalDueText" FontSize="16" FontWeight="Bold" Foreground="#2D3748"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="12,10">
                        <StackPanel Spacing="2">
                            <TextBlock Text="AMOUNT PAID" FontSize="11" FontWeight="SemiBold" Foreground="#A0AEC0"/>
                            <TextBlock x:Name="TotalPaidText" FontSize="16" FontWeight="Bold" Foreground="#059669"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- NOTE SELECTION -->
            <StackPanel Grid.Row="1" Spacing="10">
                <TextBlock Text="Insert Cash" FontSize="16" FontWeight="Bold" Foreground="#2D3748"/>

                <StackPanel Spacing="6">
                    <TextBlock Text="USD NOTES" FontSize="11" FontWeight="SemiBold" Foreground="#A0AEC0"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" HorizontalScrollMode="Enabled">
                        <StackPanel x:Name="UsdNotesPanel" Orientation="Horizontal" Spacing="8">
                            <Button Content="$1"    Tag="1"    Style="{StaticResource NoteButtonStyle}"/>
                            <Button Content="$5"    Tag="5"    Style="{StaticResource NoteButtonStyle}"/>
                            <Button Content="$10"   Tag="10"   Style="{StaticResource NoteButtonStyle}"/>
                            <Button Content="$20"   Tag="20"   Style="{StaticResource NoteButtonStyle}"/>
                            <Button Content="$50"   Tag="50"   Style="{StaticResource NoteButtonStyle}"/>
                            <Button Content="$100"  Tag="100"  Style="{StaticResource NoteButtonStyle}"/>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="KHR NOTES" FontSize="11" FontWeight="SemiBold" Foreground="#A0AEC0"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" HorizontalScrollMode="Enabled">
                        <StackPanel x:Name="KhrNotesPanel" Orientation="Horizontal" Spacing="8">
                            <Button Content="៛100"     Tag="100"    Style="{StaticResource NoteButtonStyle}"/>
                            <Button Content="៛500"     Tag="500"    Style="{StaticResource NoteButtonStyle}"/>
                            <Button Content="៛1,000"   Tag="1000"   Style="{StaticResource NoteButtonStyle}"/>
                            <Button Content="៛2,000"   Tag="2000"   Style="{StaticResource NoteButtonStyle}"/>
                            <Button Content="៛5,000"   Tag="5000"   Style="{StaticResource NoteButtonStyle}"/>
                            <Button Content="៛10,000"  Tag="10000"  Style="{StaticResource NoteButtonStyle}"/>
                            <Button Content="៛20,000"  Tag="20000"  Style="{StaticResource NoteButtonStyle}"/>
                            <Button Content="៛50,000"  Tag="50000"  Style="{StaticResource NoteButtonStyle}"/>
                            <Button Content="៛100,000" Tag="100000" Style="{StaticResource NoteButtonStyle}"/>
                            <Button Content="៛200,000" Tag="200000" Style="{StaticResource NoteButtonStyle}"/>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </StackPanel>

            <!-- ACTIVITY (Fills remaining space and scrolls internally when messages overflow) -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="Activity" FontSize="16" FontWeight="Bold" Foreground="#2D3748" Margin="0,0,0,6"/>

                <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="4">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="AttemptsListControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:PaymentAttempt">
                                    <Border Padding="12" Margin="4" CornerRadius="10" BorderThickness="1" Loaded="AttemptRow_Loaded">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <FontIcon x:Name="StatusIcon" Grid.Column="0" FontFamily="Segoe Fluent Icons"
                                                      FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock x:Name="AmountText" Text="{x:Bind DisplayAmount}" FontWeight="Bold" FontSize="15"/>
                                                <TextBlock x:Name="ReasonText" Text="{x:Bind Reason}" FontSize="12" Foreground="#718096" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- 3. FOOTER -->
        <Border Grid.Row="2" Background="White" Padding="20,20" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <StackPanel Spacing="10">

                <!-- Currency Acceptance Note -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                    <FontIcon FontFamily="Segoe Fluent Icons" 
                          Glyph="&#xE946;" 
                          FontSize="14" 
                          Foreground="Green" 
                          VerticalAlignment="Center"/>
                    <TextBlock Text="USD ($) and KHR (៛) cash are both accepted" 
                           FontSize="13" 
                           FontWeight="SemiBold" 
                           Foreground="Green"
                           VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Confirm Button -->
                <Button x:Name="ConfirmPaymentButton"
                        Content="Confirm Payment"
                        HorizontalAlignment="Stretch"
                        Height="80"
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="White"
                        CornerRadius="16"
                        IsEnabled="False">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2563EB" Offset="0"/>
                            <GradientStop Color="#1D4ED8" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#005A9E"/>
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#004578"/>
                        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#E2E8F0"/>
                        <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#94A3B8"/>

                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/>
                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White"/>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>