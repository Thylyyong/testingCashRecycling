<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SelfCheckoutKiosk.App.Views.Customer.IngestionProgressView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SelfCheckoutKiosk.App.Views.Customer"
    xmlns:models="using:SelfCheckoutKiosk.App.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Light">

    <Page.Resources>

        <Style x:Key="HeaderChipButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{StaticResource KioskChipCornerRadius}"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Height" Value="40"/>
        </Style>

        <!-- Kiosk-sized touch target note button style -->
        <Style x:Key="NoteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextItemNameBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="CornerRadius" Value="{StaticResource KioskButtonCornerRadius}"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>

    </Page.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <!-- ========================================================= -->
        <!-- VISUAL STATE MANAGER (ADAPTIVE KIOSK SCALING) -->
        <!-- ========================================================= -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">

                <!-- 1. SMALL VERTICAL TEST STATE (Compact portrait test window, base/default) -->
                <VisualState x:Name="SmallVerticalTestState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" MinWindowHeight="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!-- Header -->
                        <Setter Target="HeaderBorder.Padding" Value="16,10"/>
                        <Setter Target="HeaderBorder.Height" Value="64"/>
                        <Setter Target="HeaderTitleText.FontSize" Value="{StaticResource FontSizeTitle}"/>
                        <Setter Target="BackButton.Height" Value="40"/>
                        <Setter Target="BackButtonIcon.FontSize" Value="16"/>

                        <!-- Main Layout -->
                        <Setter Target="MainBodyGrid.Margin" Value="14,10,14,10"/>

                        <!-- Hero Balance & Metrics -->
                        <Setter Target="RemainingDueCard.Padding" Value="14,10"/>
                        <Setter Target="RemainingDueLabel.FontSize" Value="{StaticResource FontSizeSubLabel}"/>
                        <Setter Target="RemainingDueText.FontSize" Value="26"/>
                        <Setter Target="PaidProgressBar.Height" Value="6"/>

                        <Setter Target="TotalDueCard.Padding" Value="10,8"/>
                        <Setter Target="TotalDueLabel.FontSize" Value="{StaticResource FontSizeCaption}"/>
                        <Setter Target="TotalDueText.FontSize" Value="{StaticResource FontSizeSubtitle}"/>

                        <Setter Target="TotalPaidCard.Padding" Value="10,8"/>
                        <Setter Target="TotalPaidLabel.FontSize" Value="{StaticResource FontSizeCaption}"/>
                        <Setter Target="TotalPaidText.FontSize" Value="{StaticResource FontSizeSubtitle}"/>

                        <!-- Note Insertion -->
                        <Setter Target="InsertCashLabel.FontSize" Value="{StaticResource FontSizeBodyLarge}"/>
                        <Setter Target="UsdNotesLabel.FontSize" Value="{StaticResource FontSizeCaption}"/>
                        <Setter Target="KhrNotesLabel.FontSize" Value="{StaticResource FontSizeCaption}"/>

                        <!-- Activity Feed -->
                        <Setter Target="ActivityLabel.FontSize" Value="{StaticResource FontSizeBodyLarge}"/>
                        <Setter Target="ActivityBorder.Padding" Value="3"/>

                        <!-- Footer -->
                        <Setter Target="FooterBorder.Padding" Value="16,12,16,14"/>
                        <Setter Target="CurrencyInfoIcon.FontSize" Value="{StaticResource FontSizeBody}"/>
                        <Setter Target="CurrencyInfoText.FontSize" Value="{StaticResource FontSizeSubLabel}"/>
                        <Setter Target="ConfirmPaymentButton.Height" Value="52"/>
                        <Setter Target="ConfirmPaymentButton.FontSize" Value="17"/>
                    </VisualState.Setters>
                </VisualState>

                <!-- 2. HORIZONTAL KIOSK STATE: 16:9, 17.3 Inches (1920x1080) -->
                <VisualState x:Name="Horizontal17InchState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1400" MinWindowHeight="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!-- Header -->
                        <Setter Target="HeaderBorder.Padding" Value="32,14"/>
                        <Setter Target="HeaderBorder.Height" Value="84"/>
                        <Setter Target="HeaderTitleText.FontSize" Value="{StaticResource FontSizeHeroMedium}"/>
                        <Setter Target="BackButton.Height" Value="54"/>
                        <Setter Target="BackButtonIcon.FontSize" Value="21"/>

                        <!-- Main Layout -->
                        <Setter Target="MainBodyGrid.Margin" Value="32,18,32,18"/>

                        <!-- Hero Balance & Metrics -->
                        <Setter Target="RemainingDueCard.Padding" Value="20,14"/>
                        <Setter Target="RemainingDueLabel.FontSize" Value="{StaticResource FontSizeBodyLarge}"/>
                        <Setter Target="RemainingDueText.FontSize" Value="36"/>
                        <Setter Target="PaidProgressBar.Height" Value="9"/>

                        <Setter Target="TotalDueCard.Padding" Value="16,12"/>
                        <Setter Target="TotalDueLabel.FontSize" Value="{StaticResource FontSizeBody}"/>
                        <Setter Target="TotalDueText.FontSize" Value="{StaticResource FontSizeTitle}"/>

                        <Setter Target="TotalPaidCard.Padding" Value="16,12"/>
                        <Setter Target="TotalPaidLabel.FontSize" Value="{StaticResource FontSizeBody}"/>
                        <Setter Target="TotalPaidText.FontSize" Value="{StaticResource FontSizeTitle}"/>

                        <!-- Note Insertion -->
                        <Setter Target="InsertCashLabel.FontSize" Value="{StaticResource FontSizeTitle}"/>
                        <Setter Target="UsdNotesLabel.FontSize" Value="{StaticResource FontSizeBody}"/>
                        <Setter Target="KhrNotesLabel.FontSize" Value="{StaticResource FontSizeBody}"/>

                        <!-- Activity Feed -->
                        <Setter Target="ActivityLabel.FontSize" Value="{StaticResource FontSizeTitle}"/>
                        <Setter Target="ActivityBorder.Padding" Value="6"/>

                        <!-- Footer -->
                        <Setter Target="FooterBorder.Padding" Value="32,18,32,20"/>
                        <Setter Target="CurrencyInfoIcon.FontSize" Value="{StaticResource FontSizeTitleSmall}"/>
                        <Setter Target="CurrencyInfoText.FontSize" Value="{StaticResource FontSizeSubtitle}"/>
                        <Setter Target="ConfirmPaymentButton.Height" Value="70"/>
                        <Setter Target="ConfirmPaymentButton.FontSize" Value="22"/>
                    </VisualState.Setters>
                </VisualState>

                <!-- 3. VERTICAL KIOSK STATE: 9:16, 27.5 Inches (1080x1920) -->
                <VisualState x:Name="Vertical27InchState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" MinWindowHeight="1200"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!-- Header -->
                        <Setter Target="HeaderBorder.Padding" Value="48,16"/>
                        <Setter Target="HeaderBorder.Height" Value="100"/>
                        <Setter Target="HeaderTitleText.FontSize" Value="34"/>
                        <Setter Target="BackButton.Height" Value="64"/>
                        <Setter Target="BackButtonIcon.FontSize" Value="26"/>

                        <!-- Main Layout -->
                        <Setter Target="MainBodyGrid.Margin" Value="48,28,48,28"/>

                        <!-- Hero Balance & Metrics -->
                        <Setter Target="RemainingDueCard.Padding" Value="24,20"/>
                        <Setter Target="RemainingDueLabel.FontSize" Value="15"/>
                        <Setter Target="RemainingDueText.FontSize" Value="48"/>
                        <Setter Target="PaidProgressBar.Height" Value="12"/>

                        <Setter Target="TotalDueCard.Padding" Value="20,16"/>
                        <Setter Target="TotalDueLabel.FontSize" Value="{StaticResource FontSizeSubtitle}"/>
                        <Setter Target="TotalDueText.FontSize" Value="{StaticResource FontSizeHeroSmall}"/>

                        <Setter Target="TotalPaidCard.Padding" Value="20,16"/>
                        <Setter Target="TotalPaidLabel.FontSize" Value="{StaticResource FontSizeSubtitle}"/>
                        <Setter Target="TotalPaidText.FontSize" Value="{StaticResource FontSizeHeroSmall}"/>

                        <!-- Note Insertion -->
                        <Setter Target="InsertCashLabel.FontSize" Value="{StaticResource FontSizeHeroSmall}"/>
                        <Setter Target="UsdNotesLabel.FontSize" Value="{StaticResource FontSizeSubtitle}"/>
                        <Setter Target="KhrNotesLabel.FontSize" Value="{StaticResource FontSizeSubtitle}"/>

                        <!-- Activity Feed -->
                        <Setter Target="ActivityLabel.FontSize" Value="{StaticResource FontSizeHeroSmall}"/>
                        <Setter Target="ActivityBorder.Padding" Value="8"/>

                        <!-- Footer -->
                        <Setter Target="FooterBorder.Padding" Value="48,28,48,32"/>
                        <Setter Target="CurrencyInfoIcon.FontSize" Value="20"/>
                        <Setter Target="CurrencyInfoText.FontSize" Value="{StaticResource FontSizeTitle}"/>
                        <Setter Target="ConfirmPaymentButton.Height" Value="96"/>
                        <Setter Target="ConfirmPaymentButton.FontSize" Value="28"/>
                    </VisualState.Setters>
                </VisualState>

            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. HEADER -->
        <Border x:Name="HeaderBorder" Grid.Row="0" Background="{StaticResource AccentBlueBrush}" Padding="24,16" Height="80">
            <Grid VerticalAlignment="Center">

                <!-- Centered Title -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                    <TextBlock x:Name="HeaderTitleText" Text="{x:Bind Localizer.GetString('CashPayment'), Mode=OneWay}" Foreground="{StaticResource TextOnAccentBrush}" FontSize="{StaticResource FontSizeHeroMedium}" FontWeight="Bold"/>
                </StackPanel>

                <!-- Left Floating Button -->
                <Button x:Name="BackButton" 
                        Height="50" 
                        HorizontalAlignment="Left" 
                        VerticalAlignment="Center" 
                        CornerRadius="10"
                        Visibility="{x:Bind local:IngestionProgressView.BoolToVisibility(ViewModel.CanNavigateBack), Mode=OneWay}"
                        Style="{StaticResource HeaderChipButtonStyle}">

                    <Button.Resources>
                        <!-- Pointer Over & Pressed States -->
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2D8EDD"/>
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#166BAE"/>

                        <!-- Disabled States -->
                        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#005096"/>
                        <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#66FFFFFF"/>
                        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent"/>

                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/>
                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White"/>
                    </Button.Resources>

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon x:Name="BackButtonIcon" FontFamily="Segoe Fluent Icons" Glyph="&#xE830;" FontSize="20"/>
                    </StackPanel>
                </Button>

                <!-- Right Floating Action Buttons -->
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="AdminButton"
                            Height="50"
                            CornerRadius="10"
                            IsTabStop="False"
                            Click="AdminButton_Click"
                            Style="{StaticResource HeaderChipButtonStyle}">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2D8EDD"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#166BAE"/>
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/>
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White"/>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7EE;" FontFamily="Segoe Fluent Icons" FontSize="18"/>
                            <TextBlock Text="{x:Bind Localizer.GetString('Admin'), Mode=OneWay}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="HelpButton"
                            Height="50"
                            CornerRadius="10"
                            Click="HelpButton_Click"
                            Style="{StaticResource HeaderChipButtonStyle}">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2D8EDD"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#166BAE"/>
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/>
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White"/>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE9CE;" FontFamily="Segoe Fluent Icons" FontSize="18"/>
                            <TextBlock Text="{x:Bind Localizer.GetString('NeedHelp'), Mode=OneWay}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

            </Grid>
        </Border>

        <!-- 2. BODY -->
        <Grid x:Name="MainBodyGrid" Grid.Row="1" RowSpacing="16" Margin="24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Balance Section -->
                <RowDefinition Height="Auto"/>
                <!-- Cash Insertion Buttons -->
                <RowDefinition Height="*"/>
                <!-- Activity Feed (Scrollable) -->
            </Grid.RowDefinitions>

            <!-- BALANCE SUMMARY -->
            <StackPanel Grid.Row="0" Spacing="10">

                <!-- Hero: remaining balance -->
                <Border x:Name="RemainingDueCard" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource KioskHeroCardCornerRadius}" Padding="16,12">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="RemainingDueLabel" Text="{x:Bind Localizer.GetString('AmountRemaining'), Mode=OneWay}" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Foreground="{StaticResource TextSubLabelBrush}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="RemainingDueText" Text="{x:Bind ViewModel.FormattedRemaining, Mode=OneWay}" FontSize="{StaticResource FontSizeHeroLarge}" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center"/>
                        <ProgressBar x:Name="PaidProgressBar" Minimum="0" Maximum="100" Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" Height="8" CornerRadius="4"
                                     Foreground="{StaticResource SuccessBrush}" Background="{StaticResource CardBorderBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Sub stats -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="TotalDueCard" Grid.Column="0" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource KioskCardCornerRadius}" Padding="12,10">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="TotalDueLabel" Text="{x:Bind Localizer.GetString('TotalDue'), Mode=OneWay}" FontSize="{StaticResource FontSizeSubLabel}" FontWeight="SemiBold" Foreground="{StaticResource TextSubLabelBrush}"/>
                            <TextBlock x:Name="TotalDueText" Text="{x:Bind ViewModel.FormattedTotalDue, Mode=OneWay}" FontSize="{StaticResource FontSizeTitleSmall}" FontWeight="Bold" Foreground="{StaticResource TextItemNameBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="TotalPaidCard" Grid.Column="1" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource KioskCardCornerRadius}" Padding="12,10">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="TotalPaidLabel" Text="{x:Bind Localizer.GetString('AmountPaid'), Mode=OneWay}" FontSize="{StaticResource FontSizeSubLabel}" FontWeight="SemiBold" Foreground="{StaticResource TextSubLabelBrush}"/>
                            <TextBlock x:Name="TotalPaidText" Text="{x:Bind ViewModel.FormattedTotalPaid, Mode=OneWay}" FontSize="{StaticResource FontSizeTitleSmall}" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- ========================================================================= -->
            <!-- PHYSICAL BANKNOTE ACCEPTOR PROMPT                                          -->
            <!-- ========================================================================= -->
            <Border Grid.Row="1" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource KioskCardCornerRadius}" Padding="20,16" Margin="0,4,0,4">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="56" Height="56" CornerRadius="28" Background="#E6F4EA" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8C7;" FontFamily="Segoe Fluent Icons" FontSize="26" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{x:Bind Localizer.GetString('InsertCashPrompt'), Mode=OneWay}" FontSize="{StaticResource FontSizeBodyLarge}" FontWeight="Bold" Foreground="{StaticResource TextItemNameBrush}"/>
                        <TextBlock Text="Insert banknotes (USD $ or KHR ៛) one at a time into the lighted slot below." FontSize="{StaticResource FontSizeSubLabel}" Foreground="{StaticResource TextSubLabelBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ACTIVITY -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="ActivityLabel" Grid.Row="0" Text="{x:Bind Localizer.GetString('Activity'), Mode=OneWay}" FontSize="{StaticResource FontSizeTitleSmall}" FontWeight="Bold" Foreground="{StaticResource TextItemNameBrush}" Margin="0,0,0,6"/>

                <Border x:Name="ActivityBorder" Grid.Row="1" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource KioskCardCornerRadius}" Padding="4">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="AttemptsListControl" ItemsSource="{x:Bind ViewModel.Attempts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:PaymentAttempt">
                                    <Border Padding="12" Margin="4" CornerRadius="10" BorderThickness="1" Loaded="AttemptRow_Loaded">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <FontIcon x:Name="StatusIcon" Grid.Column="0" FontFamily="Segoe Fluent Icons"
                                                      FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock x:Name="AmountText" Text="{x:Bind DisplayAmount}" FontWeight="Bold" FontFamily="{StaticResource GlobalAppFont}" FontSize="15"/>
                                                    <TextBlock x:Name="StatusBadge" Text="{x:Bind StatusText}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Padding="6,2"/>
                                                </StackPanel>
                                                <TextBlock x:Name="ReasonText" Text="{x:Bind Reason}" FontSize="{StaticResource FontSizeBody}" FontFamily="{StaticResource GlobalAppFont}" Foreground="{StaticResource TextQuantityBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <TextBlock x:Name="TimeText" Grid.Column="2" Text="{x:Bind DisplayTime}" FontSize="12" Foreground="{StaticResource TextQuantityBrush}" VerticalAlignment="Top" Margin="8,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                     </ScrollViewer>
                 </Border>
             </Grid>
         </Grid>

         <!-- 3. FOOTER -->
         <Border x:Name="FooterBorder" Grid.Row="2" Background="{StaticResource CardBackgroundBrush}" Padding="24,20" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0">
             <StackPanel Spacing="10">

                 <!-- Currency Acceptance Note -->
                 <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                     <FontIcon x:Name="CurrencyInfoIcon"
                               FontFamily="Segoe Fluent Icons" 
                               Glyph="&#xE946;" 
                               FontSize="{StaticResource FontSizeSubtitle}" 
                               Foreground="{StaticResource SuccessBrush}" 
                               VerticalAlignment="Center"/>
                     <TextBlock x:Name="CurrencyInfoText"
                                Text="{x:Bind Localizer.GetString('CurrencyInfoText'), Mode=OneWay}"
                                FontSize="{StaticResource FontSizeBodyLarge}" 
                                FontWeight="SemiBold" 
                                Foreground="{StaticResource SuccessBrush}"
                                VerticalAlignment="Center"/>
                 </StackPanel>

                 <!-- Confirm Button -->
                 <Button x:Name="ConfirmPaymentButton"
                         Content="{x:Bind Localizer.GetString('ConfirmPayment'), Mode=OneWay}"
                         HorizontalAlignment="Stretch"
                         Height="80"
                         FontSize="24"
                         FontWeight="Bold"
                         Foreground="{StaticResource TextOnAccentBrush}"
                         CornerRadius="{StaticResource KioskHeroCardCornerRadius}"
                         IsEnabled="{x:Bind ViewModel.IsFullyPaid, Mode=OneWay}"
                         Background="{StaticResource PrimaryCardGradientBrush}">
                     <Button.Resources>
                         <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#005A9E"/>
                         <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#004578"/>
                         <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#E2E8F0"/>
                         <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#94A3B8"/>

                         <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/>
                         <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White"/>
                     </Button.Resources>
                 </Button>
             </StackPanel>
         </Border>
    </Grid>
</Page>