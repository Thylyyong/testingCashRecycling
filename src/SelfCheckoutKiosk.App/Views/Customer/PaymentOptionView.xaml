<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SelfCheckoutKiosk.App.Views.Customer.PaymentOptionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SelfCheckoutKiosk.App.Views.Customer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- ENABLED CARD STYLE -->
        <Style x:Key="PaymentCardEnabledStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>

        <!-- DISABLED CARD STYLE -->
        <Style x:Key="PaymentCardDisabledStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Opacity" Value="0.6"/>
        </Style>

        <Style x:Key="PaymentIconStyle" TargetType="FontIcon">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
            <Setter Property="FontSize" Value="110"/>
        </Style>

        <Style x:Key="PaymentTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,20,0,6"/>
            <Setter Property="FontFamily" Value="{StaticResource GlobalAppFont}"/>
        </Style>

        <Style x:Key="PaymentSubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="{StaticResource GlobalAppFont}"/>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource CardBackgroundBrush}"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto" MaxHeight="160"/>
            <!-- 1: Payment cards grid -->
            <RowDefinition Height="*"/>
            <!-- 2: Back button -->
            <RowDefinition Height="Auto" MaxHeight="160"/>
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- 0. HEADER                                                 -->
        <!-- ========================================================= -->
        <Grid Grid.Row="0" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1">
            <Grid x:Name="HeaderContainer" Margin="32,20,32,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderSubTitle" Text="{x:Bind Localizer.GetString('PaymentOptionSubTitle'), Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" CharacterSpacing="100"/>
                    <TextBlock x:Name="HeaderTitle" Text="{x:Bind Localizer.GetString('PaymentOptionTitle'), Mode=OneWay}" FontSize="36" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
                <Button x:Name="AdminButton" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1.5" CornerRadius="24" Padding="18,10"
                        Click="AdminButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE7EE;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{StaticResource TextDarkSlateBrush}"/>
                        <TextBlock Text="{x:Bind Localizer.GetString('Admin'), Mode=OneWay}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextDarkSlateBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- ========================================================= -->
        <!-- 1. PAYMENT CARDS                                          -->
        <!-- Dynamic Layout: 2x3 (Vertical) or 3x2 (Horizontal)         -->
        <!-- ========================================================= -->
        <Grid x:Name="CardsGrid" Grid.Row="1" Padding="32,16" RowSpacing="16" ColumnSpacing="16" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== CASH CARD (Row 0, Col 0) ===== -->
            <Viewbox x:Name="CashViewbox" Grid.Row="0" Grid.Column="0" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Button x:Name="CashCard" Width="360" Height="360" Style="{StaticResource PaymentCardEnabledStyle}">
                    <Button.Resources>
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SurfaceHoverBrush"/>
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SurfaceLightBrush"/>
                        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="PrimaryBrandBrush"/>
                        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="PrimaryBrandBrush"/>
                    </Button.Resources>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon x:Name="CashIcon" Glyph="&#xE8C7;" Foreground="{StaticResource PrimaryBrandBrush}" Style="{StaticResource PaymentIconStyle}"/>
                        <TextBlock x:Name="CashTitleText" Text="{x:Bind Localizer.GetString('CashTitle'), Mode=OneWay}" Foreground="{StaticResource TextDarkSlateBrush}" Style="{StaticResource PaymentTitleStyle}"/>
                        <TextBlock x:Name="CashSubtitleText" Text="{x:Bind Localizer.GetString('CashSubTitle'), Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" Style="{StaticResource PaymentSubtitleStyle}"/>
                    </StackPanel>
                </Button>
            </Viewbox>

            <!-- ===== KHQR CARD (Row 0, Col 1) ===== -->
            <Viewbox x:Name="KhqrViewbox" Grid.Row="0" Grid.Column="1" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Button x:Name="KhqrCard" Width="360" Height="360" Style="{StaticResource PaymentCardEnabledStyle}">
                    <Button.Resources>
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SurfaceHoverBrush"/>
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SurfaceLightBrush"/>
                        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="PrimaryBrandBrush"/>
                        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="PrimaryBrandBrush"/>
                    </Button.Resources>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon x:Name="KhqrIcon" Glyph="&#xED14;" Foreground="{StaticResource PrimaryBrandBrush}" Style="{StaticResource PaymentIconStyle}"/>
                        <TextBlock x:Name="KhqrTitleText" Text="{x:Bind Localizer.GetString('KhqrTitle'), Mode=OneWay}" Foreground="{StaticResource TextDarkSlateBrush}" Style="{StaticResource PaymentTitleStyle}"/>
                        <TextBlock x:Name="KhqrSubtitleText" Text="{x:Bind Localizer.GetString('KhqrSubTitle'), Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" Style="{StaticResource PaymentSubtitleStyle}"/>
                    </StackPanel>
                </Button>
            </Viewbox>

            <!-- ===== DEBIT / CREDIT CARD (Row 1, Col 0 in vertical / Row 0, Col 2 in horizontal) ===== -->
            <Viewbox x:Name="CardViewbox" Grid.Row="1" Grid.Column="0" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Button x:Name="CardCard" Width="360" Height="360" Style="{StaticResource PaymentCardDisabledStyle}">
                    <Button.Resources>
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SurfaceHoverBrush"/>
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SurfaceLightBrush"/>
                        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="PrimaryBrandBrush"/>
                        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="PrimaryBrandBrush"/>
                    </Button.Resources>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon x:Name="CardIcon" Glyph="&#xE8C7;" Foreground="{StaticResource TextMutedBrush}" Style="{StaticResource PaymentIconStyle}"/>
                        <TextBlock x:Name="CardTitleText" Text="{x:Bind Localizer.GetString('CardTitle'), Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" Style="{StaticResource PaymentTitleStyle}"/>
                        <TextBlock x:Name="CardSubtitleText" Text="{x:Bind Localizer.GetString('Unavailable'), Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" Style="{StaticResource PaymentSubtitleStyle}"/>
                    </StackPanel>
                </Button>
            </Viewbox>

            <!-- ===== INTERNATIONAL QR CARD (Row 1, Col 1 in vertical / Row 1, Col 0 in horizontal) ===== -->
            <Viewbox x:Name="IntlQrViewbox" Grid.Row="1" Grid.Column="1" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Button x:Name="IntlQrCard" Width="360" Height="360" Style="{StaticResource PaymentCardDisabledStyle}">
                    <Button.Resources>
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SurfaceHoverBrush"/>
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SurfaceLightBrush"/>
                        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="PrimaryBrandBrush"/>
                        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="PrimaryBrandBrush"/>
                    </Button.Resources>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon x:Name="IntlQrIcon" Glyph="&#xED14;" Foreground="{StaticResource TextMutedBrush}" Style="{StaticResource PaymentIconStyle}"/>
                        <TextBlock x:Name="IntlQrTitleText" Text="{x:Bind Localizer.GetString('IntlQrTitle'), Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" Style="{StaticResource PaymentTitleStyle}"/>
                        <TextBlock x:Name="IntlQrSubtitleText" Text="{x:Bind Localizer.GetString('Unavailable'), Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" Style="{StaticResource PaymentSubtitleStyle}"/>
                    </StackPanel>
                </Button>
            </Viewbox>

            <!-- ===== MEMBERSHIP CARD (Row 2, Col 0 in vertical / Row 1, Col 1 in horizontal) ===== -->
            <Viewbox x:Name="MembershipViewbox" Grid.Row="2" Grid.Column="0" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Button x:Name="MembershipCard" Width="360" Height="360" Style="{StaticResource PaymentCardDisabledStyle}">
                    <Button.Resources>
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SurfaceHoverBrush"/>
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SurfaceLightBrush"/>
                        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="PrimaryBrandBrush"/>
                        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="PrimaryBrandBrush"/>
                    </Button.Resources>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon x:Name="MembershipIcon" Glyph="&#xE8C3;" Foreground="{StaticResource TextMutedBrush}" Style="{StaticResource PaymentIconStyle}"/>
                        <TextBlock x:Name="MembershipTitleText" Text="{x:Bind Localizer.GetString('MembershipTitle'), Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" Style="{StaticResource PaymentTitleStyle}"/>
                        <TextBlock x:Name="MembershipSubtitleText" Text="{x:Bind Localizer.GetString('Unavailable'), Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" Style="{StaticResource PaymentSubtitleStyle}"/>
                    </StackPanel>
                </Button>
            </Viewbox>

            <!-- ===== COUPON CARD (Row 2, Col 1 in vertical / Row 1, Col 2 in horizontal) ===== -->
            <Viewbox x:Name="CouponViewbox" Grid.Row="2" Grid.Column="1" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Button x:Name="CouponCard" Width="360" Height="360" Style="{StaticResource PaymentCardDisabledStyle}">
                    <Button.Resources>
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SurfaceHoverBrush"/>
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SurfaceLightBrush"/>
                        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="PrimaryBrandBrush"/>
                        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="PrimaryBrandBrush"/>
                    </Button.Resources>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon x:Name="CouponIcon" Glyph="&#xE8EC;" Foreground="{StaticResource TextMutedBrush}" Style="{StaticResource PaymentIconStyle}"/>
                        <TextBlock x:Name="CouponTitleText" Text="{x:Bind Localizer.GetString('CouponTitle'), Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" Style="{StaticResource PaymentTitleStyle}"/>
                        <TextBlock x:Name="CouponSubtitleText" Text="{x:Bind Localizer.GetString('Unavailable'), Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" Style="{StaticResource PaymentSubtitleStyle}"/>
                    </StackPanel>
                </Button>
            </Viewbox>
        </Grid>

        <!-- ========================================================= -->
        <!-- 2. BACK BUTTON                                            -->
        <!-- ========================================================= -->
        <Grid x:Name="FooterContainer" Grid.Row="2" Padding="32,0,32,24">
            <Button x:Name="BackButton" Height="72" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="2" CornerRadius="16" Click="BackButton_Click">
                <Button.Resources>
                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SurfaceHoverBrush"/>
                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SurfaceLightBrush"/>
                    <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="TextMutedBrush"/>
                    <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="TextMutedBrush"/>
                </Button.Resources>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <TextBlock x:Name="BackButtonText" Text="{x:Bind Localizer.GetString('BackText'), Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextDarkSlateBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>