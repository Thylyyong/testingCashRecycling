<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="SelfCheckoutKiosk.App.Views.Customer.SuccessView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:SelfCheckoutKiosk.App.Views.Customer"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      RequestedTheme="Light">

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- KIOSK HEADER -->
        <Border Grid.Row="0" Background="#0067C0" Padding="28,12" Height="80" MaxHeight="80">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEC61;" FontSize="28" Foreground="White"/>
                <TextBlock Text="Payment Completed" Foreground="White" FontSize="26" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- MAIN BODY -->
        <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Width="460" Spacing="22" HorizontalAlignment="Center">

                <!-- Status badge -->
                <!--<Border Width="88" Height="88" CornerRadius="44" Background="#ECFDF5"
                        BorderBrush="#059669" BorderThickness="2" HorizontalAlignment="Center">
                </Border>-->
                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEC61;" FontSize="80"
                              Foreground="#059669" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- Status Header -->
                <StackPanel HorizontalAlignment="Center" Spacing="4">
                    <TextBlock Text="Payment Complete" FontSize="30" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TransactionIdText" FontFamily="Consolas" FontSize="13"
                               Foreground="#94A3B8" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- RECEIPT CARD -->
                <Border Background="#FFFDF9" BorderBrush="#E7E2D6" BorderThickness="1"
                        CornerRadius="16" Padding="32,28" HorizontalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Stretch">

                        <TextBlock Text="TOTAL PAID" FontSize="12" FontWeight="Bold" Foreground="#64748B"
                                   HorizontalAlignment="Center" CharacterSpacing="80"/>

                        <!-- Primary amount: USD -->
                        <TextBlock x:Name="TotalPaidText" Text="$0.00" FontFamily="Consolas"
                                   FontSize="44" FontWeight="Bold" Foreground="#0F172A"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>

                        <!-- Secondary amount: KHR -->
                        <TextBlock x:Name="TotalPaidKhrText" Text="≈ ៛0" FontFamily="Consolas"
                                   FontSize="17" FontWeight="SemiBold" Foreground="#B45309"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>

                        <!-- Divider -->
                        <Rectangle Height="1" Fill="#E2DDD0" HorizontalAlignment="Stretch" Margin="0,20,0,16"/>

                        <!-- Payment method -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8C7;" FontSize="16" Foreground="#0067C0"/>
                            <TextBlock x:Name="MethodLabelText" Text="Paid with Cash" FontSize="15"
                                       FontWeight="SemiBold" Foreground="#475569"/>
                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- Printer warning: hidden unless printing failed -->
                <Border x:Name="PrinterWarningBanner" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1"
                        CornerRadius="12" Padding="16,12" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7BA;" FontSize="16" Foreground="#B45309"/>
                        <TextBlock x:Name="PrinterWarningText"
                                   Text="We couldn't print your receipt — please ask a staff member."
                                   FontSize="14" Foreground="#92400E" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Redirect countdown -->
                <StackPanel Spacing="8" HorizontalAlignment="Stretch" Margin="0,2,0,0">
                    <TextBlock x:Name="TimerCountdownText"
                               Text="This screen will return to the start in 60 seconds"
                               FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                    <ProgressBar x:Name="RedirectProgressBar" Minimum="0" Maximum="60" Value="60"
                                 Height="4" Width="220" HorizontalAlignment="Center"
                                 Foreground="#0067C0" Background="#E2E8F0" CornerRadius="2"/>
                </StackPanel>

            </StackPanel>
        </Grid>

        <!-- KIOSK FOOTER -->
        <Grid Grid.Row="2" Background="White" Padding="32,20">
            <Button x:Name="DoneButton" HorizontalAlignment="Stretch" Height="72" CornerRadius="16" Click="DoneButton_Click">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2563EB" Offset="0"/>
                        <GradientStop Color="#1D4ED8" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>

                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1D4ED8"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1E40AF"/>
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/>
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White"/>
                </Button.Resources>

                <TextBlock Text="DONE" FontWeight="Bold" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" CharacterSpacing="60"/>
            </Button>
        </Grid>
    </Grid>
</Page>