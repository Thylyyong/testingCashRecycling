<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SelfCheckoutKiosk.App.Views.Customer.PaymentSelectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SelfCheckoutKiosk.App.Views.Customer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- ENABLED CARD STYLE -->
        <Style x:Key="PaymentCardEnabledStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>

        <!-- DISABLED CARD STYLE -->
        <Style x:Key="PaymentCardDisabledStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Opacity" Value="0.6"/>
        </Style>

        <Style x:Key="PaymentIconStyle" TargetType="FontIcon">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
            <Setter Property="FontSize" Value="110"/>
        </Style>

        <Style x:Key="PaymentTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,20,0,6"/>
            <Setter Property="FontFamily" Value="{StaticResource GlobalAppFont}"/>
        </Style>

        <Style x:Key="PaymentSubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="{StaticResource GlobalAppFont}"/>
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource CardBackgroundBrush}">
        <!-- ========================================================= -->
        <!-- VISUAL STATE MANAGER (ADAPTIVE RESPONSIVE STATES)          -->
        <!-- ========================================================= -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="DisplayStates">
                <!-- DEFAULT STATE: Optimized for Small Vertical Testing Displays (< 1200px Height) -->
                <VisualState x:Name="SmallVerticalState" />

                <!-- LARGE VERTICAL KIOSK STATE: 27.5 Inch (1080x1920) -->
                <VisualState x:Name="LargeVerticalKioskState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowHeight="1200" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderContainer.Margin" Value="64,48,64,36" />
                        <Setter Target="CardsGrid.Padding" Value="64,40" />
                        <Setter Target="FooterContainer.Padding" Value="64,0,64,48" />
                        <Setter Target="HeaderTitle.FontSize" Value="48" />
                        <Setter Target="HeaderSubTitle.FontSize" Value="20" />
                        <Setter Target="CancelButton.Height" Value="96" />
                        <Setter Target="CancelButtonText.FontSize" Value="28" />
                        <Setter Target="HelpButton.Padding" Value="28,14" />
                    </VisualState.Setters>
                </VisualState>

                <!-- HORIZONTAL KIOSK STATE: 17.3 Inch (1920x1080) -->
                <VisualState x:Name="HorizontalKioskState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1200" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderContainer.Margin" Value="48,16,48,12" />
                        <Setter Target="CardsGrid.Padding" Value="48,16" />
                        <Setter Target="FooterContainer.Padding" Value="48,0,48,20" />
                        <Setter Target="HeaderTitle.FontSize" Value="32" />
                        <Setter Target="HeaderSubTitle.FontSize" Value="14" />
                        <Setter Target="CancelButton.Height" Value="64" />
                        <Setter Target="CancelButtonText.FontSize" Value="20" />
                        <Setter Target="HelpButton.Padding" Value="18,10" />
                        <!-- Switch Cards to 3 Columns x 2 Rows for Horizontal Display -->
                        <Setter Target="CardsGrid.ColumnDefinitions[0].Width" Value="*" />
                        <Setter Target="CardsGrid.ColumnDefinitions[1].Width" Value="20" />
                        <Setter Target="CardsGrid.ColumnDefinitions[2].Width" Value="*" />
                        <Setter Target="CardsGrid.ColumnDefinitions[3].Width" Value="20" />
                        <Setter Target="CardsGrid.ColumnDefinitions[4].Width" Value="*" />
                        <Setter Target="CardsGrid.RowDefinitions[0].Height" Value="*" />
                        <Setter Target="CardsGrid.RowDefinitions[1].Height" Value="20" />
                        <Setter Target="CardsGrid.RowDefinitions[2].Height" Value="*" />
                        <Setter Target="CardsGrid.RowDefinitions[3].Height" Value="0" />
                        <Setter Target="CardsGrid.RowDefinitions[4].Height" Value="0" />
                        <!-- Reposition Cards for 3x2 Grid Placement -->
                        <Setter Target="CardViewbox.Grid.Row" Value="0" />
                        <Setter Target="CardViewbox.Grid.Column" Value="4" />
                        <Setter Target="IntlQrViewbox.Grid.Row" Value="2" />
                        <Setter Target="IntlQrViewbox.Grid.Column" Value="0" />
                        <Setter Target="MembershipViewbox.Grid.Row" Value="2" />
                        <Setter Target="MembershipViewbox.Grid.Column" Value="2" />
                        <Setter Target="CouponViewbox.Grid.Row" Value="2" />
                        <Setter Target="CouponViewbox.Grid.Column" Value="4" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Payment cards grid -->
            <RowDefinition Height="*"/>
            <!-- 2: Cancel button -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- 0. HEADER                                                 -->
        <!-- ========================================================= -->
        <Grid Grid.Row="0" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1">
            <Grid x:Name="HeaderContainer" Margin="32,20,32,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderSubTitle" Text="{x:Bind Localizer.GetString('CHECKOUT'), Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" CharacterSpacing="100"/>
                    <TextBlock x:Name="HeaderTitle" Text="{x:Bind Localizer.GetString('PaymentOptionTitle'), Mode=OneWay}" FontSize="36" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
                <Button x:Name="HelpButton" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1.5" CornerRadius="24" Padding="20,10"
                        Click="HelpButton_Click">
                    <StackPanel x:Name="HelpButtonStack" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon x:Name="HelpButtonIcon" Glyph="&#xE9CE;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{StaticResource TextDarkSlateBrush}"/>
                        <TextBlock x:Name="HelpButtonText" Text="{x:Bind Localizer.GetString('NeedHelp'), Mode=OneWay}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextDarkSlateBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- ========================================================= -->
        <!-- 1. PAYMENT CARDS                                          -->
        <!-- Dynamic Layout: 2x3 (Vertical) or 3x2 (Horizontal)         -->
        <!-- ========================================================= -->
        <Grid x:Name="CardsGrid" Grid.Row="1" Padding="32,20" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0"/>
                <ColumnDefinition Width="0"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== CASH CARD ===== -->
            <Viewbox x:Name="CashViewbox" Grid.Row="0" Grid.Column="0" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Button x:Name="CashCard" Width="360" Height="360" Style="{StaticResource PaymentCardEnabledStyle}" Click="CashCard_Click">
                    <Button.Resources>
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SurfaceHoverBrush"/>
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SurfaceLightBrush"/>
                        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="PrimaryBrandBrush"/>
                        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="PrimaryBrandBrush"/>
                    </Button.Resources>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon x:Name="CashIcon" Glyph="&#xE8C7;" Foreground="{StaticResource PrimaryBrandBrush}" Style="{StaticResource PaymentIconStyle}"/>
                        <TextBlock x:Name="CashTitleText" Text="{x:Bind Localizer.GetString('CashTitle'), Mode=OneWay}" Foreground="{StaticResource TextDarkSlateBrush}" Style="{StaticResource PaymentTitleStyle}"/>
                        <TextBlock x:Name="CashSubtitleText" Text="{x:Bind Localizer.GetString('CashSubTitle'), Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" Style="{StaticResource PaymentSubtitleStyle}"/>
                    </StackPanel>
                </Button>
            </Viewbox>

            <!-- ===== KHQR CARD ===== -->
            <Viewbox x:Name="KhqrViewbox" Grid.Row="0" Grid.Column="2" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Button x:Name="KhqrCard" Width="360" Height="360" Style="{StaticResource PaymentCardEnabledStyle}" Click="KhqrCard_Click">
                    <Button.Resources>
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SurfaceHoverBrush"/>
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SurfaceLightBrush"/>
                        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="PrimaryBrandBrush"/>
                        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="PrimaryBrandBrush"/>
                    </Button.Resources>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon x:Name="KhqrIcon" Glyph="&#xED14;" Foreground="{StaticResource PrimaryBrandBrush}" Style="{StaticResource PaymentIconStyle}"/>
                        <TextBlock x:Name="KhqrTitleText" Text="{x:Bind Localizer.GetString('KhqrTitle'), Mode=OneWay}" Foreground="{StaticResource TextDarkSlateBrush}" Style="{StaticResource PaymentTitleStyle}"/>
                        <TextBlock x:Name="KhqrSubtitleText" Text="{x:Bind Localizer.GetString('KhqrSubTitle'), Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" Style="{StaticResource PaymentSubtitleStyle}"/>
                    </StackPanel>
                </Button>
            </Viewbox>

            <!-- ===== DEBIT / CREDIT CARD ===== -->
            <Viewbox x:Name="CardViewbox" Grid.Row="2" Grid.Column="0" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Button x:Name="CardCard" Width="360" Height="360" Style="{StaticResource PaymentCardDisabledStyle}" IsEnabled="False" Click="CardCard_Click">
                    <Button.Resources>
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SurfaceHoverBrush"/>
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SurfaceLightBrush"/>
                        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="PrimaryBrandBrush"/>
                        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="PrimaryBrandBrush"/>
                    </Button.Resources>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon x:Name="CardIcon" Glyph="&#xE8C7;" Foreground="{StaticResource TextMutedBrush}" Style="{StaticResource PaymentIconStyle}"/>
                        <TextBlock x:Name="CardTitleText" Text="{x:Bind Localizer.GetString('CardTitle'), Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" Style="{StaticResource PaymentTitleStyle}"/>
                        <TextBlock x:Name="CardSubtitleText" Text="{x:Bind Localizer.GetString('Unavailable'), Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" Style="{StaticResource PaymentSubtitleStyle}"/>
                    </StackPanel>
                </Button>
            </Viewbox>

            <!-- ===== INTERNATIONAL QR CARD ===== -->
            <Viewbox x:Name="IntlQrViewbox" Grid.Row="2" Grid.Column="2" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Button x:Name="IntlQrCard" Width="360" Height="360" Style="{StaticResource PaymentCardDisabledStyle}" IsEnabled="False" Click="IntlQrCard_Click">
                    <Button.Resources>
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SurfaceHoverBrush"/>
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SurfaceLightBrush"/>
                        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="PrimaryBrandBrush"/>
                        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="PrimaryBrandBrush"/>
                    </Button.Resources>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon x:Name="IntlQrIcon" Glyph="&#xED14;" Foreground="{StaticResource TextMutedBrush}" Style="{StaticResource PaymentIconStyle}"/>
                        <TextBlock x:Name="IntlQrTitleText" Text="{x:Bind Localizer.GetString('IntlQrTitle'), Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" Style="{StaticResource PaymentTitleStyle}"/>
                        <TextBlock x:Name="IntlQrSubtitleText" Text="{x:Bind Localizer.GetString('Unavailable'), Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" Style="{StaticResource PaymentSubtitleStyle}"/>
                    </StackPanel>
                </Button>
            </Viewbox>

            <!-- ===== MEMBERSHIP CARD ===== -->
            <Viewbox x:Name="MembershipViewbox" Grid.Row="4" Grid.Column="0" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Button x:Name="MembershipCard" Width="360" Height="360" Style="{StaticResource PaymentCardDisabledStyle}" IsEnabled="False" Click="MembershipCard_Click">
                    <Button.Resources>
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SurfaceHoverBrush"/>
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SurfaceLightBrush"/>
                        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="PrimaryBrandBrush"/>
                        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="PrimaryBrandBrush"/>
                    </Button.Resources>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon x:Name="MembershipIcon" Glyph="&#xE8C3;" Foreground="{StaticResource TextMutedBrush}" Style="{StaticResource PaymentIconStyle}"/>
                        <TextBlock x:Name="MembershipTitleText" Text="{x:Bind Localizer.GetString('MembershipTitle'), Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" Style="{StaticResource PaymentTitleStyle}"/>
                        <TextBlock x:Name="MembershipSubtitleText" Text="{x:Bind Localizer.GetString('Unavailable'), Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" Style="{StaticResource PaymentSubtitleStyle}"/>
                    </StackPanel>
                </Button>
            </Viewbox>

            <!-- ===== COUPON CARD ===== -->
            <Viewbox x:Name="CouponViewbox" Grid.Row="4" Grid.Column="2" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Button x:Name="CouponCard" Width="360" Height="360" Style="{StaticResource PaymentCardDisabledStyle}" IsEnabled="False" Click="CouponCard_Click">
                    <Button.Resources>
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SurfaceHoverBrush"/>
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SurfaceLightBrush"/>
                        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="PrimaryBrandBrush"/>
                        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="PrimaryBrandBrush"/>
                    </Button.Resources>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon x:Name="CouponIcon" Glyph="&#xE8EC;" Foreground="{StaticResource TextMutedBrush}" Style="{StaticResource PaymentIconStyle}"/>
                        <TextBlock x:Name="CouponTitleText" Text="{x:Bind Localizer.GetString('CouponTitle'), Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" Style="{StaticResource PaymentTitleStyle}"/>
                        <TextBlock x:Name="CouponSubtitleText" Text="{x:Bind Localizer.GetString('Unavailable'), Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" Style="{StaticResource PaymentSubtitleStyle}"/>
                    </StackPanel>
                </Button>
            </Viewbox>
        </Grid>

        <!-- ========================================================= -->
        <!-- 2. CANCEL BUTTON                                          -->
        <!-- ========================================================= -->
        <Grid x:Name="FooterContainer" Grid.Row="2" Padding="32,0,32,24">
            <Button x:Name="CancelButton" Height="72" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource DangerBrush}" BorderThickness="2" CornerRadius="16" Click="CancelButton_Click">
                <Button.Resources>
                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="DangerLightBrush"/>
                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="DangerLightPressedBrush"/>
                    <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="DangerBrush"/>
                    <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="DangerBrush"/>
                </Button.Resources>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <TextBlock x:Name="CancelButtonText" Text="{x:Bind Localizer.GetString('ReturnToCart'), Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>