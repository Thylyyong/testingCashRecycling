<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SelfCheckoutKiosk.App.Views.Customer.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- LANGUAGE DROPDOWN -->
        <Style x:Key="LanguageDropDownButtonStyle" TargetType="DropDownButton">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="16,8"/>
        </Style>
        <Style x:Key="LanguageMenuItemStyle" TargetType="MenuFlyoutItem">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="MinWidth" Value="160"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontFamily" Value="{StaticResource KhmerFont}"/>
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid" Background="White">

        <!-- ========================================================= -->
        <!-- VISUAL STATE MANAGER (RESPONSIVE SCALING) -->
        <!-- ========================================================= -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="AdaptiveLayoutStates">
                <VisualState x:Name="DefaultKioskState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowHeight="0"/>
                    </VisualState.StateTriggers>
                </VisualState>

                <!-- 27.5" 9:16 Vertical Screen (1080x1920) -->
                <VisualState x:Name="LargeVerticalKioskState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowHeight="1000"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!-- 0. Language Switcher Scaling -->
                        <Setter Target="LanguageDropDownButton.Padding" Value="24,12"/>
                        <Setter Target="LanguageDropDownButton.CornerRadius" Value="28"/>
                        <Setter Target="CurrentLanguageFlag.Width" Value="36"/>
                        <Setter Target="CurrentLanguageFlag.Height" Value="24"/>
                        <Setter Target="CurrentLanguageText.FontSize" Value="22"/>

                        <!-- Dropdown Menu Scaling -->
                        <Setter Target="EnglishMenuItem.FontSize" Value="22"/>
                        <Setter Target="EnglishMenuItem.Padding" Value="24,16"/>
                        <Setter Target="EnglishMenuIcon.Width" Value="36"/>
                        <Setter Target="EnglishMenuIcon.Height" Value="24"/>

                        <Setter Target="KhmerMenuItem.FontSize" Value="22"/>
                        <Setter Target="KhmerMenuItem.Padding" Value="24,16"/>
                        <Setter Target="KhmerMenuIcon.Width" Value="36"/>
                        <Setter Target="KhmerMenuIcon.Height" Value="24"/>

                        <!-- 1. Welcome Heading Scaling -->
                        <Setter Target="WelcomeStackPanel.Spacing" Value="10"/>
                        <Setter Target="WelcomeSubheadingText.FontSize" Value="22"/>
                        <Setter Target="WelcomeTitleText.FontSize" Value="56"/>

                        <!-- 3. Footer Scaling -->
                        <Setter Target="FooterGrid.Padding" Value="40,0"/>
                        <Setter Target="StoreHoursStack.Spacing" Value="12"/>
                        <Setter Target="StoreHoursIcon.FontSize" Value="24"/>
                        <Setter Target="StoreHoursText.FontSize" Value="20"/>
                        <Setter Target="HelpButton.Padding" Value="28,14"/>
                        <Setter Target="HelpButton.CornerRadius" Value="32"/>
                        <Setter Target="HelpButtonStack.Spacing" Value="12"/>
                        <Setter Target="HelpButtonIcon.FontSize" Value="24"/>
                        <Setter Target="HelpButtonText.FontSize" Value="20"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <!-- 0: Language bar -->
            <RowDefinition Height="8*"/>
            <!-- 1: Welcome heading -->
            <RowDefinition Height="14*"/>
            <!-- 2: Cards -->
            <RowDefinition Height="58*"/>
            <!-- 3: Footer -->
            <RowDefinition Height="12*"/>
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- 0. LANGUAGE SWITCHER -->
        <!-- ========================================================= -->
        <Grid Grid.Row="0" Padding="28,0" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <DropDownButton x:Name="LanguageDropDownButton" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource LanguageDropDownButtonStyle}" RequestedTheme="Light">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Image x:Name="CurrentLanguageFlag" Width="24" Height="16" Stretch="Uniform" Source="ms-appx:///Assets/Images/Flag/en-flag.png"/>
                    <TextBlock x:Name="CurrentLanguageText" Text="English" FontSize="16" FontWeight="SemiBold" Foreground="#334155"/>
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <!-- ENGLISH -->
                        <MenuFlyoutItem x:Name="EnglishMenuItem" Text="English" Style="{StaticResource LanguageMenuItemStyle}" RequestedTheme="Light" Click="LanguageItem_Click">
                            <MenuFlyoutItem.Icon>
                                <ImageIcon x:Name="EnglishMenuIcon" Width="26" Height="18" Source="ms-appx:///Assets/Images/Flag/en-flag.png"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <!-- KHMER -->
                        <MenuFlyoutItem x:Name="KhmerMenuItem" Text="ភាសាខ្មែរ" Style="{StaticResource LanguageMenuItemStyle}" RequestedTheme="Light" Click="LanguageItem_Click">
                            <MenuFlyoutItem.Icon>
                                <ImageIcon x:Name="KhmerMenuIcon" Width="26" Height="18" Source="ms-appx:///Assets/Images/Flag/km-flag.png"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <!-- ========================================================= -->
        <!-- 1. WELCOME HEADING -->
        <!-- ========================================================= -->
        <StackPanel x:Name="WelcomeStackPanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
            <TextBlock x:Name="WelcomeSubheadingText" Text="WELCOME TO" FontSize="16" FontWeight="SemiBold" Foreground="#94A3B8" CharacterSpacing="100" HorizontalAlignment="Center"/>
            <TextBlock x:Name="WelcomeTitleText" Text="Self-Checkout" FontSize="38" FontWeight="Bold" Foreground="#1A202C" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- ========================================================= -->
        <!-- 2. ACTION CARDS (UNCHANGED) -->
        <!-- ========================================================= -->
        <Grid Grid.Row="2" Padding="40,0" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SCAN ITEM CARD -->
            <Viewbox Grid.Column="0" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Button Width="400" Height="400" CornerRadius="28" BorderThickness="0" Padding="24" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Click="ScanItemCard_Click">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2563EB" Offset="0"/>
                            <GradientStop Color="#1D4ED8" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>

                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1D4ED8"/>
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1E40AF"/>

                        <!-- Floating & pulse scan animation -->
                        <Storyboard x:Name="ScanIconAnimation" AutoReverse="True" RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="IconTransform"
                                             Storyboard.TargetProperty="Y"
                                             From="-1" To="1.5" Duration="0:0:1.2">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </Button.Resources>

                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ICON -->
                        <Viewbox Grid.Row="0" MaxWidth="120" MaxHeight="120" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,20">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEC5A;" Foreground="White" Loaded="ScanIcon_Loaded">
                                <FontIcon.RenderTransform>
                                    <TranslateTransform x:Name="IconTransform" Y="0"/>
                                </FontIcon.RenderTransform>
                            </FontIcon>
                        </Viewbox>

                        <!-- MAIN TITLE -->
                        <TextBlock Grid.Row="1" Text="Scan Item" FontWeight="Bold" FontSize="38" Foreground="White" HorizontalAlignment="Center" TextAlignment="Center"/>

                        <!-- SUBTITLE -->
                        <TextBlock Grid.Row="2" Text="Self Checkout Scanner" FontSize="22" Foreground="#E2E8F0" Opacity="0.95" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0"/>
                    </Grid>
                </Button>
            </Viewbox>

            <!-- PAYMENT OPTIONS CARD -->
            <Viewbox Grid.Column="2" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Button Width="400" Height="400" CornerRadius="28" Background="White" BorderBrush="#CBD5E1" BorderThickness="2" Padding="24" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Click="PaymentOptionsCard_Click">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#F8FAFC"/>
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#F1F5F9"/>
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#CBD5E1"/>
                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#CBD5E1"/>

                        <!-- Floating payment icon animation -->
                        <Storyboard x:Name="PaymentIconAnimation" AutoReverse="True" RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="PaymentIconTransform"
                                             Storyboard.TargetProperty="Y"
                                             From="-1" To="1.5" Duration="0:0:1.2">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </Button.Resources>

                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ICON -->
                        <Viewbox Grid.Row="0" MaxWidth="120" MaxHeight="120" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,20">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8C7;" Foreground="#0067C0">
                                <FontIcon.RenderTransform>
                                    <TranslateTransform x:Name="PaymentIconTransform" Y="0"/>
                                </FontIcon.RenderTransform>
                            </FontIcon>
                        </Viewbox>

                        <!-- MAIN TITLE -->
                        <TextBlock Grid.Row="1" Text="Payment" FontWeight="Bold" FontSize="38" Foreground="#1E293B" HorizontalAlignment="Center" TextAlignment="Center"/>

                        <!-- SUBTITLE -->
                        <TextBlock Grid.Row="2" Text="Cards, Cash &amp; KHQR" FontSize="22" Foreground="#64748B" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0"/>
                    </Grid>
                </Button>
            </Viewbox>
        </Grid>

        <!-- ========================================================= -->
        <!-- 3. FOOTER -->
        <!-- ========================================================= -->
        <Grid x:Name="FooterGrid" Grid.Row="3" Padding="28,0" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- STORE HOURS -->
            <StackPanel x:Name="StoreHoursStack" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <FontIcon x:Name="StoreHoursIcon" FontFamily="Segoe Fluent Icons" Glyph="&#xE823;" FontSize="16" Foreground="#94A3B8"/>
                <TextBlock x:Name="StoreHoursText" Text="Open until 9:00 PM" FontSize="14" Foreground="#94A3B8"/>
            </StackPanel>

            <!-- HELP BUTTON -->
            <Button Grid.Column="1" x:Name="HelpButton" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="24" Padding="20,10" Click="HelpButton_Click">
                <StackPanel x:Name="HelpButtonStack" Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="HelpButtonIcon" FontFamily="Segoe Fluent Icons" Glyph="&#xE9CE;" FontSize="16" Foreground="#334155"/>
                    <TextBlock x:Name="HelpButtonText" Text="Need help?" FontSize="16" FontWeight="SemiBold" Foreground="#334155"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>