<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SelfCheckoutKiosk.App.Views.Customer.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:SelfCheckoutKiosk.App.Services"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- LANGUAGE DROPDOWN -->
        <Style x:Key="LanguageDropDownButtonStyle" TargetType="DropDownButton">
            <Setter Property="Background" Value="{StaticResource SurfaceLightBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextDarkSlateBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontFamily" Value="{StaticResource AppKhmerFont}"/>
        </Style>
        <Style x:Key="LanguageMenuItemStyle" TargetType="MenuFlyoutItem">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource TextDarkSlateBrush}"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="MinWidth" Value="160"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontFamily" Value="{StaticResource AppKhmerFont}"/>
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid" Background="White">

        <!-- ========================================================= -->
        <!-- VISUAL STATE MANAGER (RESPONSIVE SCALING) -->
        <!-- ========================================================= -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="AdaptiveLayoutStates">

                <!-- 1. Horizontal Kiosk: 16:9, 17.3 Inches (1920x1080) -->
                <VisualState x:Name="Horizontal17InchState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowHeight="0" MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!-- Language Switcher Sizing -->
                        <Setter Target="LanguageDropDownButton.Padding" Value="16,8"/>
                        <Setter Target="LanguageDropDownButton.CornerRadius" Value="20"/>
                        <Setter Target="CurrentLanguageFlag.Width" Value="24"/>
                        <Setter Target="CurrentLanguageFlag.Height" Value="16"/>
                        <Setter Target="CurrentLanguageText.FontSize" Value="16"/>

                        <!-- MenuFlyout Item Sizing -->
                        <Setter Target="EnglishMenuItem.FontSize" Value="16"/>
                        <Setter Target="EnglishMenuItem.Padding" Value="16,10"/>
                        <Setter Target="EnglishMenuIcon.Width" Value="24"/>
                        <Setter Target="EnglishMenuIcon.Height" Value="16"/>
                        <Setter Target="KhmerMenuItem.FontSize" Value="16"/>
                        <Setter Target="KhmerMenuItem.Padding" Value="16,10"/>
                        <Setter Target="KhmerMenuIcon.Width" Value="24"/>
                        <Setter Target="KhmerMenuIcon.Height" Value="16"/>

                        <!-- Welcome & Branding Heading Sizing -->
                        <Setter Target="WelcomeStackPanel.Spacing" Value="6"/>
                        <Setter Target="BrandLogoBorder.Width" Value="42"/>
                        <Setter Target="BrandLogoBorder.Height" Value="42"/>
                        <Setter Target="BrandNameText.FontSize" Value="20"/>
                        <Setter Target="BrandTaglineText.FontSize" Value="12"/>
                        <Setter Target="WelcomeSubheadingText.FontSize" Value="15"/>
                        <Setter Target="WelcomeTitleText.FontSize" Value="15"/>

                        <!-- Action Cards Grid Padding & Spacing -->
                        <Setter Target="ActionCardsGrid.Padding" Value="36,0"/>
                        <Setter Target="ActionCardsSpacer.Width" Value="28"/>

                        <!-- Action Cards Internal Dimensions -->
                        <Setter Target="ScanButton.Width" Value="360"/>
                        <Setter Target="ScanButton.Height" Value="360"/>
                        <Setter Target="ScanButton.CornerRadius" Value="24"/>
                        <Setter Target="ScanIconViewbox.MaxWidth" Value="100"/>
                        <Setter Target="ScanIconViewbox.MaxHeight" Value="100"/>
                        <Setter Target="ScanTitleText.FontSize" Value="32"/>
                        <Setter Target="ScanSubtitleText.FontSize" Value="18"/>

                        <Setter Target="PaymentButton.Width" Value="360"/>
                        <Setter Target="PaymentButton.Height" Value="360"/>
                        <Setter Target="PaymentButton.CornerRadius" Value="24"/>
                        <Setter Target="PaymentIconViewbox.MaxWidth" Value="100"/>
                        <Setter Target="PaymentIconViewbox.MaxHeight" Value="100"/>
                        <Setter Target="PaymentTitleText.FontSize" Value="32"/>
                        <Setter Target="PaymentSubtitleText.FontSize" Value="18"/>

                        <!-- Footer Sizing -->
                        <Setter Target="FooterGrid.Padding" Value="36,0"/>
                        <Setter Target="StoreHoursStack.Spacing" Value="8"/>
                        <Setter Target="StoreHoursIcon.FontSize" Value="16"/>
                        <Setter Target="StoreHoursText.FontSize" Value="15"/>
                        <Setter Target="HelpButton.Padding" Value="20,10"/>
                        <Setter Target="HelpButton.CornerRadius" Value="24"/>
                        <Setter Target="HelpButtonStack.Spacing" Value="8"/>
                        <Setter Target="HelpButtonIcon.FontSize" Value="16"/>
                        <Setter Target="HelpButtonText.FontSize" Value="15"/>
                    </VisualState.Setters>
                </VisualState>

                <!-- 2. Vertical Kiosk: 9:16, 27.5 Inches (1080x1920) -->
                <VisualState x:Name="Vertical27InchState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowHeight="1200" MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!-- Language Switcher Sizing -->
                        <Setter Target="LanguageDropDownButton.Padding" Value="26,14"/>
                        <Setter Target="LanguageDropDownButton.CornerRadius" Value="28"/>
                        <Setter Target="CurrentLanguageFlag.Width" Value="36"/>
                        <Setter Target="CurrentLanguageFlag.Height" Value="24"/>
                        <Setter Target="CurrentLanguageText.FontSize" Value="22"/>

                        <!-- MenuFlyout Item Sizing -->
                        <Setter Target="EnglishMenuItem.FontSize" Value="22"/>
                        <Setter Target="EnglishMenuItem.Padding" Value="24,16"/>
                        <Setter Target="EnglishMenuIcon.Width" Value="36"/>
                        <Setter Target="EnglishMenuIcon.Height" Value="24"/>
                        <Setter Target="KhmerMenuItem.FontSize" Value="22"/>
                        <Setter Target="KhmerMenuItem.Padding" Value="24,16"/>
                        <Setter Target="KhmerMenuIcon.Width" Value="36"/>
                        <Setter Target="KhmerMenuIcon.Height" Value="24"/>

                        <!-- Welcome & Branding Heading Sizing -->
                        <Setter Target="WelcomeStackPanel.Spacing" Value="10"/>
                        <Setter Target="BrandLogoBorder.Width" Value="60"/>
                        <Setter Target="BrandLogoBorder.Height" Value="60"/>
                        <Setter Target="BrandNameText.FontSize" Value="30"/>
                        <Setter Target="BrandTaglineText.FontSize" Value="16"/>
                        <Setter Target="WelcomeSubheadingText.FontSize" Value="20"/>
                        <Setter Target="WelcomeTitleText.FontSize" Value="20"/>

                        <!-- Action Cards Grid Padding & Spacing -->
                        <Setter Target="ActionCardsGrid.Padding" Value="48,0"/>
                        <Setter Target="ActionCardsSpacer.Width" Value="36"/>

                        <!-- Action Cards Internal Dimensions -->
                        <Setter Target="ScanButton.Width" Value="440"/>
                        <Setter Target="ScanButton.Height" Value="440"/>
                        <Setter Target="ScanButton.CornerRadius" Value="32"/>
                        <Setter Target="ScanIconViewbox.MaxWidth" Value="130"/>
                        <Setter Target="ScanIconViewbox.MaxHeight" Value="130"/>
                        <Setter Target="ScanTitleText.FontSize" Value="42"/>
                        <Setter Target="ScanSubtitleText.FontSize" Value="24"/>

                        <Setter Target="PaymentButton.Width" Value="440"/>
                        <Setter Target="PaymentButton.Height" Value="440"/>
                        <Setter Target="PaymentButton.CornerRadius" Value="32"/>
                        <Setter Target="PaymentIconViewbox.MaxWidth" Value="130"/>
                        <Setter Target="PaymentIconViewbox.MaxHeight" Value="130"/>
                        <Setter Target="PaymentTitleText.FontSize" Value="42"/>
                        <Setter Target="PaymentSubtitleText.FontSize" Value="24"/>

                        <!-- Footer Sizing -->
                        <Setter Target="FooterGrid.Padding" Value="48,0"/>
                        <Setter Target="StoreHoursStack.Spacing" Value="12"/>
                        <Setter Target="StoreHoursIcon.FontSize" Value="24"/>
                        <Setter Target="StoreHoursText.FontSize" Value="20"/>
                        <Setter Target="HelpButton.Padding" Value="28,14"/>
                        <Setter Target="HelpButton.CornerRadius" Value="32"/>
                        <Setter Target="HelpButtonStack.Spacing" Value="12"/>
                        <Setter Target="HelpButtonIcon.FontSize" Value="24"/>
                        <Setter Target="HelpButtonText.FontSize" Value="20"/>
                    </VisualState.Setters>
                </VisualState>

            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <!-- 0: Language bar -->
            <RowDefinition Height="8*"/>
            <!-- 1: Welcome heading & Branding -->
            <RowDefinition Height="14*"/>
            <!-- 2: Cards -->
            <RowDefinition Height="58*"/>
            <!-- 3: Footer -->
            <RowDefinition Height="12*"/>
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- 0. LANGUAGE SWITCHER -->
        <!-- ========================================================= -->
        <Grid Grid.Row="0" Padding="28,0" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <DropDownButton x:Name="LanguageDropDownButton" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource LanguageDropDownButtonStyle}" RequestedTheme="Light">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Image x:Name="CurrentLanguageFlag" Width="24" Height="16" Stretch="Uniform" Source="ms-appx:///Assets/Images/Flag/en-flag.png"/>
                    <TextBlock x:Name="CurrentLanguageText" Text="English" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextDarkSlateBrush}"/>
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <!-- ENGLISH -->
                        <MenuFlyoutItem x:Name="EnglishMenuItem" Text="English" Style="{StaticResource LanguageMenuItemStyle}" RequestedTheme="Light" Click="LanguageItem_Click">
                            <MenuFlyoutItem.Icon>
                                <ImageIcon x:Name="EnglishMenuIcon" Width="26" Height="18" Source="ms-appx:///Assets/Images/Flag/en-flag.png"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <!-- KHMER -->
                        <MenuFlyoutItem x:Name="KhmerMenuItem" Text="ភាសាខ្មែរ" Style="{StaticResource LanguageMenuItemStyle}" RequestedTheme="Light" Click="LanguageItem_Click">
                            <MenuFlyoutItem.Icon>
                                <ImageIcon x:Name="KhmerMenuIcon" Width="26" Height="18" Source="ms-appx:///Assets/Images/Flag/km-flag.png"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>

            <!-- ADMIN BUTTON (Top Right) -->
            <Button x:Name="AdminButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Background="Transparent" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1.5"
                    CornerRadius="20" Padding="14,8" IsTabStop="False" Click="AdminButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7EE;" FontSize="15" Foreground="{StaticResource TextDarkSlateBrush}"/>
                    <TextBlock Text="{x:Bind Localizer.GetString('Admin'), Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextDarkSlateBrush}"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ========================================================= -->
        <!-- 1. WELCOME HEADING & STORE BRANDING -->
        <!-- ========================================================= -->
        <StackPanel x:Name="WelcomeStackPanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
            <!-- Brand Badge (Logo + Name + Tagline) -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <Border x:Name="BrandLogoBorder" Width="42" Height="42" CornerRadius="10" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.5" VerticalAlignment="Center">
                    <Image x:Name="BrandLogoImage" Source="{x:Bind ViewModel.LogoUri, Mode=OneWay}" Stretch="Uniform" Margin="4"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="1">
                    <TextBlock x:Name="BrandNameText" Text="{x:Bind ViewModel.CompanyName, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="BrandTaglineText" Text="{x:Bind ViewModel.Tagline, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- Self-Checkout Subheading Title -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6" Margin="0,2,0,0">
                <TextBlock x:Name="WelcomeSubheadingText" Text="{x:Bind Localizer.GetString('WelcomeTo'), Mode=OneWay}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" CharacterSpacing="50"/>
                <TextBlock Text="•" FontSize="14" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="WelcomeTitleText" Text="{x:Bind Localizer.GetString('SelfCheckout'), Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrandBrush}"/>
            </StackPanel>
        </StackPanel>

        <!-- ========================================================= -->
        <!-- 2. ACTION CARDS -->
        <!-- ========================================================= -->
        <Grid x:Name="ActionCardsGrid" Grid.Row="2" Padding="40,0" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="ActionCardsSpacer" Width="32"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SCAN ITEM CARD -->
            <Viewbox Grid.Column="0" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Button x:Name="ScanButton" FontFamily="{StaticResource AppKhmerFont}" Width="400" Height="400" CornerRadius="28" BorderThickness="0" Padding="24" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Background="{StaticResource PrimaryCardGradientBrush}" Click="ScanItemCard_Click">

                    <Button.Resources>
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="PrimaryBrandHoverBrush"/>
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="PrimaryBrandPressedBrush"/>

                        <!-- Floating & pulse scan animation -->
                        <Storyboard x:Name="ScanIconAnimation" AutoReverse="True" RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="IconTransform"
                                             Storyboard.TargetProperty="Y"
                                             From="-1" To="1.5" Duration="0:0:1.2">
                                 <DoubleAnimation.EasingFunction>
                                     <SineEase EasingMode="EaseInOut"/>
                                 </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </Button.Resources>

                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ICON -->
                        <Viewbox x:Name="ScanIconViewbox" Grid.Row="0" MaxWidth="120" MaxHeight="120" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,20">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEE6F;" Foreground="White" Loaded="ScanIcon_Loaded">
                                <FontIcon.RenderTransform>
                                    <TranslateTransform x:Name="IconTransform" Y="0"/>
                                </FontIcon.RenderTransform>
                            </FontIcon>
                        </Viewbox>

                        <!-- MAIN TITLE -->
                        <TextBlock x:Name="ScanTitleText" Grid.Row="1" Text="{x:Bind Localizer.GetString('ScanItem'), Mode=OneWay}" FontWeight="Bold" FontSize="38" Foreground="White" HorizontalAlignment="Center" TextAlignment="Center"/>

                        <!-- SUBTITLE -->
                        <TextBlock x:Name="ScanSubtitleText" Grid.Row="2" Text="{x:Bind Localizer.GetString('ScanSubtitle'), Mode=OneWay}" FontSize="22" Foreground="#E2E8F0" Opacity="0.95" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0"/>
                    </Grid>
                </Button>
            </Viewbox>

            <!-- PAYMENT OPTIONS CARD -->
            <Viewbox Grid.Column="2" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Button x:Name="PaymentButton" Width="400" Height="400" CornerRadius="28" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="2" Padding="24" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Click="PaymentOptionsCard_Click">
                    <Button.Resources>
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SurfaceHoverBrush"/>
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SurfaceLightBrush"/>
                        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="BorderLightBrush"/>
                        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="BorderLightBrush"/>

                        <!-- Floating payment icon animation -->
                        <Storyboard x:Name="PaymentIconAnimation" AutoReverse="True" RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="PaymentIconTransform"
                                             Storyboard.TargetProperty="Y"
                                             From="-1" To="1.5" Duration="0:0:1.2">
                                 <DoubleAnimation.EasingFunction>
                                     <SineEase EasingMode="EaseInOut"/>
                                 </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </Button.Resources>

                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ICON -->
                        <Viewbox x:Name="PaymentIconViewbox" Grid.Row="0" MaxWidth="120" MaxHeight="120" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,20">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8C7;" Foreground="{StaticResource AccentBlueBrush}">
                                <FontIcon.RenderTransform>
                                    <TranslateTransform x:Name="PaymentIconTransform" Y="0"/>
                                </FontIcon.RenderTransform>
                            </FontIcon>
                        </Viewbox>

                        <!-- MAIN TITLE -->
                        <TextBlock x:Name="PaymentTitleText" Grid.Row="1" Text="{x:Bind Localizer.GetString('PaymentOptions'), Mode=OneWay}" FontWeight="Bold" FontSize="38" Foreground="#1E293B" HorizontalAlignment="Center" TextAlignment="Center"/>

                        <!-- SUBTITLE -->
                        <TextBlock x:Name="PaymentSubtitleText" Grid.Row="2" Text="{x:Bind Localizer.GetString('PaymentSubtitle'), Mode=OneWay}" FontSize="22" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0"/>
                    </Grid>
                </Button>
            </Viewbox>
        </Grid>

        <!-- ========================================================= -->
        <!-- 3. FOOTER -->
        <!-- ========================================================= -->
        <Grid x:Name="FooterGrid" Grid.Row="3" Padding="28,0" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- STORE HOURS -->
            <StackPanel x:Name="StoreHoursStack" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <FontIcon x:Name="StoreHoursIcon" FontFamily="Segoe Fluent Icons" Glyph="&#xE823;" FontSize="16" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock x:Name="StoreHoursText" Text="{x:Bind Localizer.GetString('OpenUntil'), Mode=OneWay}" FontSize="14" Foreground="{StaticResource TextMutedBrush}"/>
            </StackPanel>

            <!-- HELP BUTTON -->
            <Button Grid.Column="1" x:Name="HelpButton" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1.5" CornerRadius="24" Padding="20,10" Click="HelpButton_Click">
                <StackPanel x:Name="HelpButtonStack" Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="HelpButtonIcon" FontFamily="Segoe Fluent Icons" Glyph="&#xE9CE;" FontSize="16" Foreground="{StaticResource TextDarkSlateBrush}"/>
                    <TextBlock x:Name="HelpButtonText" Text="{x:Bind Localizer.GetString('NeedHelp'), Mode=OneWay}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextDarkSlateBrush}"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>