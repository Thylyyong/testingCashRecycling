<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SelfCheckoutKiosk.App.Views.Customer.CartView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SelfCheckoutKiosk.App.Views.Customer"
    xmlns:vm="using:SelfCheckoutKiosk.App.ViewModels.Customer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Storyboard moved here so x:Name is reliably findable in code-behind -->
    <Page.Resources>
        <Storyboard x:Name="ScanAnimation" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation
                Storyboard.TargetName="ScanLineTransform"
                Storyboard.TargetProperty="Y"
                From="0" To="96"
                Duration="0:0:1.4">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Template for each cart item card -->
        <DataTemplate x:Key="CartItemTemplate" x:DataType="vm:CartItem">
            <Border Background="White" CornerRadius="12" Padding="14" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top row: name/SKU + remove button -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,8,0">
                            <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="17"
                                Foreground="#2D3748" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind Sku}" Foreground="#A0AEC0" FontSize="12"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                            Width="40" Height="40"
                            CornerRadius="8"
                            Background="#FEF2F2"
                            Foreground="#DC2626"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Right"
                            Padding="0"
                            Tag="{x:Bind}"
                            Click="RemoveItem_Click">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FEE2E2"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FECACA"/>
                            </Button.Resources>
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74D;" FontSize="16" Foreground="#DC2626"/>
                        </Button>
                    </Grid>

                    <!-- Bottom row: price info + qty controls -->
                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock FontSize="13" Foreground="#718096">
                                <Run Text="{x:Bind PricePerItem}"/>
                                <Run Text="each"/>
                            </TextBlock>
                            <TextBlock FontWeight="Bold" FontSize="17" Foreground="#0067C0"
                                Text="{x:Bind LineTotal}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Width="44" Height="44" CornerRadius="8" Background="#EDF2F7" Foreground="#2D3748"
                                Tag="{x:Bind}" Click="Decrement_Click">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xF8AB;" FontSize="15" Foreground="Black"/>
                            </Button>

                            <TextBlock Text="{x:Bind Quantity, Mode=OneWay}" FontWeight="Bold" FontSize="19" VerticalAlignment="Center"
                                Width="28" TextAlignment="Center" Foreground="#2D3748"/>

                            <Button Width="44" Height="44" CornerRadius="8" Background="#EDF2F7" Foreground="#2D3748"
                                Tag="{x:Bind}" Click="Increment_Click">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xF8AA;" FontSize="15" Foreground="Black"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Background="#FFF4F6F8">

        <Grid.RowDefinitions>
            <RowDefinition Height="10*" />
            <RowDefinition Height="68*" />
            <RowDefinition Height="10*" />
            <RowDefinition Height="12*" />
        </Grid.RowDefinitions>

        <!-- 1. HEADER AREA -->
        <Border 
            Grid.Row="0"
            Background="#0067C0"
            Padding="20,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <FontIcon Grid.Column="0"
                    FontFamily="Segoe Fluent Icons"
                    Glyph="&#xE7BF;"
                    FontSize="32"
                    Foreground="White"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                    <TextBlock Text="Your Cart" Foreground="White" FontSize="22" FontWeight="Bold"/>
                    <TextBlock x:Name="ItemCountLabel" Text="0 items" Foreground="#D6E9FA" FontSize="14"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 1: Either EmptyCartState OR ItemsListArea shows, never both -->

        <!-- EMPTY CART STATE -->
        <Border x:Name="EmptyCartState"
            Grid.Row="1"
            Background="#FFF4F6F8"
            Visibility="Visible">

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24">

                <Grid Width="220" Height="140">
                    <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1.5" Padding="20,16">
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Rectangle Width="3"  Height="70" Fill="#2D3748"/>
                            <Rectangle Width="6"  Height="70" Fill="#2D3748"/>
                            <Rectangle Width="2"  Height="70" Fill="#2D3748"/>
                            <Rectangle Width="4"  Height="70" Fill="#2D3748"/>
                            <Rectangle Width="2"  Height="70" Fill="#2D3748"/>
                            <Rectangle Width="7"  Height="70" Fill="#2D3748"/>
                            <Rectangle Width="3"  Height="70" Fill="#2D3748"/>
                            <Rectangle Width="2"  Height="70" Fill="#2D3748"/>
                            <Rectangle Width="5"  Height="70" Fill="#2D3748"/>
                            <Rectangle Width="3"  Height="70" Fill="#2D3748"/>
                            <Rectangle Width="2"  Height="70" Fill="#2D3748"/>
                            <Rectangle Width="6"  Height="70" Fill="#2D3748"/>
                            <Rectangle Width="3"  Height="70" Fill="#2D3748"/>
                            <Rectangle Width="4"  Height="70" Fill="#2D3748"/>
                        </StackPanel>
                    </Border>

                    <Rectangle x:Name="ScanLine"
                        Width="180" Height="3"
                        Fill="#0067C0"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,20">
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="ScanLineTransform" Y="0"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Grid>

                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <TextBlock Text="Your Cart is Empty" FontWeight="Bold" FontSize="20" Foreground="#2D3748" HorizontalAlignment="Center"/>
                    <TextBlock Text="Scan an item's barcode to get started" FontSize="14" Foreground="#718096" HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- POPULATED CART STATE -->
        <Border x:Name="ItemsListArea"
            Grid.Row="1"
            Background="#FFF4F6F8"
            Padding="16,12"
            Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl
                    x:Name="CartItemsControl"
                    ItemTemplate="{StaticResource CartItemTemplate}">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="12"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 3. TOTALS SUMMARY BREAKDOWN -->
        <Border Grid.Row="2" Background="White" Padding="24,0" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Total to Pay" FontSize="15" Foreground="#718096"/>
                    <TextBlock x:Name="ItemCountSubLabel" Text="0 items in cart" FontSize="12" Foreground="#A0AEC0"/>
                </StackPanel>

                <TextBlock x:Name="TotalAmountLabel"
                    Text="$0.00"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontWeight="Bold"
                    FontSize="30"
                    Foreground="#0067C0"/>
            </Grid>
        </Border>

        <!-- 4. BOTTOM ACTION BUTTON AREA -->
        <Grid Grid.Row="3" Background="White" Padding="16" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                x:Name="BackToScanButton"
                Width="72"
                HorizontalAlignment="Stretch"
                Height="72"
                VerticalAlignment="Center"
                Margin="0,0,10,0"
                CornerRadius="12"
                Background="#F1F5F9"
                Foreground="#374151">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E5E7EB"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#D1D5DB"/>
                </Button.Resources>
                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE830;" FontSize="22" Foreground="Black"/>
            </Button>

            <Button
                Grid.Column="1"
                x:Name="CheckoutButton"
                HorizontalAlignment="Stretch"
                Height="72"
                VerticalAlignment="Center"
                CornerRadius="12"
                Background="#0067C0">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#005A9E"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#004578"/>
                </Button.Resources>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <TextBlock Text="PAY NOW" FontWeight="Bold" FontSize="18" Foreground="White"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
