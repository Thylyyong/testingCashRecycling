<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SelfCheckoutKiosk.App.Views.Customer.CartView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SelfCheckoutKiosk.App.Views.Customer"
    xmlns:vm="using:SelfCheckoutKiosk.App.ViewModels.Customer"
    xmlns:models="using:SelfCheckoutKiosk.App.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>

        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#D1D5DB"/>

        <Style x:Key="SubtleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EDF2F7"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="HeaderChipButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1F7FCB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Height" Value="40"/>
        </Style>

        <Storyboard x:Name="ScanAnimation" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="ScanLineTransform" Storyboard.TargetProperty="Y" From="0" To="96" Duration="0:0:1.4">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <SolidColorBrush x:Key="RowHighlightBrush" Color="#3310B981" />
        <!-- Soft emerald green opacity -->
        <SolidColorBrush x:Key="RowDefaultBackground" Color="Transparent" />

        <DataTemplate x:Key="CartItemTemplate" x:DataType="models:CartItem">
            <!-- Added x:Name="RowBorder" and Loaded event handler -->
            <Border x:Name="RowBorder" 
            Loaded="CartItemRow_Loaded" 
            BorderBrush="#E2E8F0" 
            BorderThickness="0,0,0,1" 
            Padding="8,18">

                <!-- Background Brush that gets animated -->
                <Border.Background>
                    <SolidColorBrush x:Name="RowBackground" Color="Transparent" />
                </Border.Background>

                <Border.Resources>
                    <!-- Flash Animation defined right inside the row template -->
                    <Storyboard x:Key="FlashAnimation">
                        <ColorAnimation
                    Storyboard.TargetName="RowBackground"
                    Storyboard.TargetProperty="Color"
                    From="#4010B981" 
                    To="Transparent"
                    Duration="0:0:0.8" />
                    </Storyboard>
                </Border.Resources>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="19" Foreground="#2D3748" TextTrimming="CharacterEllipsis"/>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Foreground="#64748B" FontSize="14">
                        <Run Text="SKU:"/>
                        <Run Text="{x:Bind Sku}"/>
                            </TextBlock>
                            <TextBlock FontSize="14" Foreground="#718096">
                        <Run Text="Qty:"/>
                        <Run Text="{x:Bind Quantity, Mode=OneWay}"/>
                        <Run Text="  •  $"/>
                        <Run Text="{x:Bind UnitPrice}"/>
                        <Run Text="each"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" FontWeight="Bold" FontSize="21" Foreground="#0067C0" VerticalAlignment="Center" Margin="0,0,18,0">
                    <Run Text="$"/><Run Text="{x:Bind LineTotal, Mode=OneWay}"/>
                        </TextBlock>

                        <Button Grid.Column="1" Width="48" Height="48" CornerRadius="8" Foreground="#DC2626" Padding="0" Tag="{x:Bind}">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FEE2E2"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FECACA"/>
                            </Button.Resources>
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74D;" FontSize="20" Foreground="#DC2626"/>
                            <Button.Flyout>
                                <Flyout Placement="Right">
                                    <Flyout.FlyoutPresenterStyle>
                                        <Style TargetType="FlyoutPresenter">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="CornerRadius" Value="10"/>
                                            <Setter Property="Padding" Value="12"/>
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>
                                    <StackPanel Spacing="10" Width="170">
                                        <TextBlock Text="Remove this item?" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#1E293B"/>
                                        <Button Content="Remove" HorizontalAlignment="Stretch" Height="38" Background="#DC2626" Foreground="White" CornerRadius="6" Tag="{x:Bind}" Click="ConfirmRemove_Click">
                                            <Button.Resources>
                                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#B91C1C"/>
                                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#991B1B"/>
                                            </Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Background="#FFF4F6F8">

        <Grid.RowDefinitions>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="6*"/>
            <RowDefinition Height="52*"/>
            <RowDefinition Height="10*"/>
            <RowDefinition Height="12*"/>
        </Grid.RowDefinitions>

        <!-- 1. HEADER AREA -->
        <Border Grid.Row="0" Background="#0067C0" Padding="20,12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <StackPanel Spacing="10" VerticalAlignment="Center">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0" FontFamily="Segoe Fluent Icons" Glyph="&#xE7BF;" FontSize="28" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                        <TextBlock Text="Your Cart" Foreground="White" FontSize="20" FontWeight="Bold"/>
                        <TextBlock x:Name="ItemCountLabel" Text="{x:Bind ViewModel.ItemCountText, Mode=OneWay}" Foreground="#D6E9FA" FontSize="13"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <FontIcon x:Name="NetworkIcon" FontFamily="Segoe Fluent Icons" Glyph="&#xE701;" FontSize="16" Foreground="#7CFC9A"/>
                        <TextBlock x:Name="NetworkStatusLabel" Text="Online" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">

                        <Button x:Name="AddItemManuallyButton" Style="{StaticResource HeaderChipButtonStyle}" Click="AddItemManuallyLink_Click">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2D8EDD"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#166BAE"/>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE710;" FontSize="15" Foreground="White"/>
                                <TextBlock Text="Add" Foreground="White" FontSize="12"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="CheckPriceButton" Style="{StaticResource HeaderChipButtonStyle}" Click="CheckPriceButton_Click">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2D8EDD"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#166BAE"/>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8EF;" FontSize="15" Foreground="White"/>
                                <TextBlock Text="Check Price" Foreground="White" FontSize="12"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="RecallButton" Style="{StaticResource HeaderChipButtonStyle}" Click="RecallButton_Click">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2D8EDD"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#166BAE"/>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7A7;" FontSize="15" Foreground="White"/>
                                <TextBlock Text="Recall" Foreground="White" FontSize="12"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="CurrencySwitchButton" Style="{StaticResource HeaderChipButtonStyle}" Click="CurrencySwitch_Click">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2D8EDD"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#166BAE"/>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE825;" FontSize="15" Foreground="White"/>
                                <TextBlock x:Name="CurrencySwitchLabel" Text="{x:Bind ViewModel.CurrencyLabel, Mode=OneWay}" Foreground="White" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button x:Name="HelpButton" Style="{StaticResource HeaderChipButtonStyle}" Click="HelpButton_Click">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2D8EDD"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#166BAE"/>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE9CE;" FontSize="16" Foreground="White"/>
                                <TextBlock Text="Help"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </Border>

        <!-- 2. PAYMENT METHODS BANNER -->
        <Border Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#0067C0" Offset="0"/>
                    <GradientStop Color="#38A5F0" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <TextBlock Text="Cash (USD/KHR) &amp; KHQR are accepted" Foreground="White" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- EMPTY CART STATE -->
        <Border x:Name="EmptyCartState" Grid.Row="2" Background="#FFF4F6F8" Visibility="Visible">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <Grid Width="220" Height="140">
                    <Border Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1.5" Padding="20,16">
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Rectangle Width="3" Height="70" Fill="#2D3748"/>
                            <Rectangle Width="6" Height="70" Fill="#2D3748"/>
                            <Rectangle Width="2" Height="70" Fill="#2D3748"/>
                            <Rectangle Width="4" Height="70" Fill="#2D3748"/>
                            <Rectangle Width="2" Height="70" Fill="#2D3748"/>
                            <Rectangle Width="7" Height="70" Fill="#2D3748"/>
                            <Rectangle Width="3" Height="70" Fill="#2D3748"/>
                            <Rectangle Width="2" Height="70" Fill="#2D3748"/>
                            <Rectangle Width="5" Height="70" Fill="#2D3748"/>
                            <Rectangle Width="3" Height="70" Fill="#2D3748"/>
                            <Rectangle Width="2" Height="70" Fill="#2D3748"/>
                            <Rectangle Width="6" Height="70" Fill="#2D3748"/>
                            <Rectangle Width="3" Height="70" Fill="#2D3748"/>
                            <Rectangle Width="4" Height="70" Fill="#2D3748"/>
                        </StackPanel>
                    </Border>

                    <Rectangle x:Name="ScanLine" Width="180" Height="3" Fill="#0067C0" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,20,0,20">
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="ScanLineTransform" Y="0"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Grid>

                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <TextBlock Text="Your Cart is Empty" FontWeight="Bold" FontSize="20" Foreground="#2D3748" HorizontalAlignment="Center"/>
                    <TextBlock Text="Scan an item to add it to your cart." FontSize="14" Foreground="#718096" HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- POPULATED CART STATE -->
        <Border x:Name="ItemsListArea" Grid.Row="2" Background="#FFF4F6F8" Padding="16,4" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="CartItemsControl" ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}" ItemTemplate="{StaticResource CartItemTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 3. TOTALS SUMMARY BREAKDOWN -->
        <Border Grid.Row="3" Background="White" Padding="24,0" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Total to Pay" FontSize="16" FontWeight="SemiBold" Foreground="#718096"/>
                    <TextBlock x:Name="ItemCountSubLabel" Text="{x:Bind ViewModel.ItemCountSubText, Mode=OneWay}" FontSize="14" Foreground="#A0AEC0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="0">
                    <TextBlock x:Name="TotalUSDLabel" Text="{x:Bind ViewModel.FormattedTotalUsd, Mode=OneWay}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="30" Foreground="#0067C0"/>
                    <TextBlock x:Name="TotalKHRLabel" Text="{x:Bind ViewModel.FormattedTotalKhr, Mode=OneWay}" HorizontalAlignment="Right" FontSize="16" FontWeight="SemiBold" Foreground="#718096"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4. BOTTOM ACTION BUTTON AREA -->
        <Grid Grid.Row="4" Background="White" Padding="16" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="BackToScanButton" Width="80" HorizontalAlignment="Stretch" Height="80" VerticalAlignment="Center" Margin="0,0,10,0" CornerRadius="16" Background="#F1F5F9" Foreground="#374151">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E5E7EB"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#D1D5DB"/>
                </Button.Resources>
                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE830;" FontSize="24" Foreground="black"/>
            </Button>

            <Button Grid.Column="1" x:Name="CheckoutButton" IsEnabled="{x:Bind ViewModel.HasItems, Mode=OneWay}" HorizontalAlignment="Stretch" Height="80" VerticalAlignment="Center" CornerRadius="16">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2563EB" Offset="0"/>
                        <GradientStop Color="#1D4ED8" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#005A9E"/>
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#004578"/>
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#E2E8F0"/>
                    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#94A3B8"/>
                </Button.Resources>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <TextBlock Text="PAY NOW" FontWeight="Bold" FontSize="24" Foreground="White"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>