<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SelfCheckoutKiosk.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SelfCheckoutKiosk.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Self Checkout Kiosk">

    <!--<Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>-->

    <Grid KeyDown="Window_KeyDown" IsTabStop="True" Background="White">
        <Frame x:Name="RootFrame"/>

        <!-- FULLSCREEN INVALID LICENSE / SYSTEM UNAVAILABLE OVERLAY (BLOCKS ALL TOUCH INPUT) -->
        <Grid x:Name="LicenseLockoutOverlay"
              Background="#000000"
              Visibility="Collapsed"
              Canvas.ZIndex="9999"
              IsHitTestVisible="True"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Viewbox Stretch="Uniform" Margin="40">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24" MaxWidth="1000">
                    <FontIcon Glyph="&#xE7BA;" FontSize="120" Foreground="#FF0000" HorizontalAlignment="Center"/>
                    <TextBlock Text="SYSTEM UNAVAILABLE: INVALID LICENSE"
                               FontSize="48"
                               FontWeight="Black"
                               Foreground="#FF0000"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               CharacterSpacing="50"/>
                    <TextBlock x:Name="LicenseLockoutDetailText"
                               Text="Hardware authentication failed or license token is missing/expired. Please contact authorized kiosk support."
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#CCCCCC"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="20,0"/>
                </StackPanel>
            </Viewbox>
        </Grid>
    </Grid>
</Window>
